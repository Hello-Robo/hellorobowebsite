---
/**
 * Media — renders a CMS media value: an image (optimized by astro:assets), an
 * animated GIF (served as-is so it keeps moving), a video ({ video: "/videos/..." } or a
 * hosted "https://..." file; muted, looping, inline — it behaves like a moving image) or
 * a YouTube video ({ youtube: id }, a 16:9 player). Videos play only while they can be seen
 * (scripts/video-play.ts), so a page full of them doesn't run a phone out of memory.
 * Style it like an image: the class lands on the <img> / <video>.
 * Videos ask for CORS (crossorigin) so bottom-bend.ts may draw them; a hosted file gets
 * ?v=2 on its address (not ?cors: S3 reads that as a request for the bucket's settings),
 * so a copy the browser saved before the bucket allowed CORS is never reused, and a video
 * that still can't load that way loads without it (it just won't bend).
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  media: ImageMetadata | { video: string } | { youtube: string };
  alt?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}
const { media, alt = '', widths, sizes, loading = 'lazy', class: className } = Astro.props;
const isVideo = 'video' in media;
const type = isVideo && /\.webm(\?|$)/i.test(media.video) ? 'video/webm' : 'video/mp4';
const videoSrc = isVideo && /^https?:/i.test(media.video) ? `${media.video}${media.video.includes('?') ? '&' : '?'}v=2` : isVideo ? media.video : '';
---
{'youtube' in media ? (
  <iframe
    class:list={['media-youtube', className]}
    src={`https://www.youtube-nocookie.com/embed/${media.youtube}?rel=0`}
    title={alt || 'YouTube video'}
    loading={loading}
    allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
    allowfullscreen
  ></iframe>
) : isVideo ? (
  <video
    class:list={['media-video', className]}
    muted
    loop
    playsinline
    data-autoplay
    crossorigin="anonymous"
    preload="none"
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
  >
    <source src={videoSrc} type={type} />
  </video>
) : 'format' in media && media.format === 'gif' ? (
  <img class={className} src={media.src} width={media.width} height={media.height} alt={alt} loading={loading} decoding="async" />
) : (
  <Image class={className} src={media} alt={alt} widths={widths} sizes={sizes} loading={loading} />
)}

<script>
  // A video that can't load with CORS loads without it: shown flat, never a blank gap
  document.querySelectorAll<HTMLVideoElement>('video.media-video[crossorigin]').forEach((v) => {
    const plain = () => {
      if (!v.hasAttribute('crossorigin')) return;
      v.removeAttribute('crossorigin');
      v.load();
    };
    if (v.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) plain();
    else v.querySelector('source:last-of-type')?.addEventListener('error', plain, { once: true });
  });
</script>

<style>
  /* 16:9 until the video's own shape is known (videos load only near the screen, and
     before that the browser would give the box a 2:1 placeholder) */
  .media-video {
    display: block;
    max-width: 100%;
    aspect-ratio: auto 16 / 9;
  }
  .media-youtube {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
</style>
