---
/**
 * VideoSlot — keeps a video's size from Figma.
 * With `src` it plays the video (muted + looping when `autoplay`, and only while it can be
 * seen: scripts/video-play.ts);
 * without it, it shows the poster or a black area of the same size.
 * A hosted video (https) is asked for with CORS so bottom-bend.ts may draw it; one that can't
 * load that way loads without it (it just won't bend), as in Media.astro.
 */
interface Props {
  ratio: string;
  /** Aspect ratio on mobile (≤ 1023px), if the Figma mobile frame differs */
  mobileRatio?: string;
  src?: string;
  /** A lighter file for phones (≤ 1023px) */
  mobileSrc?: string;
  webm?: string;
  poster?: string;
  alt?: string;
  autoplay?: boolean;
  class?: string;
}
const { ratio, mobileRatio, src, mobileSrc, webm, poster, alt = '', autoplay = false, class: className } = Astro.props;
const hosted = !!src && /^https?:/i.test(src);
---
<div class:list={['video-slot', className]} style={`--ratio: ${ratio}; --ratio-mobile: ${mobileRatio ?? ratio}`}>
  {src ? (
    <video
      class="video-slot__media"
      poster={poster}
      muted
      playsinline
      loop
      data-autoplay={autoplay ? '' : undefined}
      crossorigin={hosted ? 'anonymous' : undefined}
      preload="none"
      aria-label={alt || undefined}
    >
      {mobileSrc && <source src={mobileSrc} type="video/mp4" media="(max-width: 1023px)" />}
      {webm && <source src={webm} type="video/webm" />}
      <source src={src} type="video/mp4" />
    </video>
  ) : poster ? (
    <img class="video-slot__media" src={poster} alt={alt} loading="lazy" decoding="async" />
  ) : null}
</div>

<script>
  // A hosted video that can't load with CORS loads without it: shown flat, never a blank gap
  document.querySelectorAll<HTMLVideoElement>('video.video-slot__media[crossorigin]').forEach((v) => {
    const plain = () => {
      if (!v.hasAttribute('crossorigin')) return;
      v.removeAttribute('crossorigin');
      v.load();
    };
    if (v.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) plain();
    else v.querySelector('source:last-of-type')?.addEventListener('error', plain, { once: true });
  });
</script>

<style>
  .video-slot {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    background: var(--color-ink-warm);
    overflow: hidden;
  }
  .video-slot__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 1023px) {
    .video-slot {
      aspect-ratio: var(--ratio-mobile);
    }
  }
</style>
