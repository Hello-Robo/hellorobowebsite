---
/**
 * ReelVideo — one of the studio's hosted reels (data/reels.ts) as a moving picture: muted,
 * looping, inline, playing only while it can be seen (scripts/video-play.ts). Phones get the
 * lighter -mobile.mp4; desktop the WebM original, with the MP4 as the fallback.
 * Style it like an image: the class lands on the <video>. Put it next to the still it replaces
 * (an <img> in the same parent): the still stays hidden (no old photo flashing in before the
 * first frame; give the parent a dark background instead) and shows only if the video can't
 * load (data-failed).
 * Asked for with CORS so bottom-bend.ts may draw it; a video that can't load that way loads
 * without it (it just won't bend), as in Media.astro.
 */
import type { Reel } from '../../data/reels';

interface Props {
  reel: Reel;
  class?: string;
}
const { reel, class: className } = Astro.props;
---
<video
  class:list={['reel-video', className]}
  muted
  loop
  playsinline
  data-autoplay
  crossorigin="anonymous"
  preload="none"
  aria-hidden="true"
>
  <source src={reel.mobileSrc} type="video/mp4" media="(max-width: 1023px)" />
  <source src={reel.webm} type="video/webm" />
  <source src={reel.src} type="video/mp4" />
</video>

<script>
  // A video that can't load with CORS loads without it (shown flat); one that can't load at
  // all is marked data-failed, and the still next to it shows instead
  document.querySelectorAll<HTMLVideoElement>('video.reel-video[crossorigin]').forEach((v) => {
    const retry = () => {
      if (!v.hasAttribute('crossorigin')) return v.setAttribute('data-failed', '');
      v.removeAttribute('crossorigin');
      v.load();
    };
    v.querySelector('source:last-of-type')?.addEventListener('error', retry);
    if (v.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) retry();
  });
</script>

<style>
  /* the still beside a reel stays hidden unless the reel failed */
  :global(:has(> video.reel-video:not([data-failed])) > img) {
    display: none;
  }
</style>
