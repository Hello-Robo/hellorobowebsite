---
/**
 * Contact block — every screen of "Start a project" / "Drop a quick word" in one plain light
 * grey block (grey-100, black text; the white stickers drawn black on it; the "system log"
 * text behind the printers is hidden)
 * Figma: 10412:2240 (cover) · 10412:2249 (start) · 10412:2436 / 2548 / 10419:222 (steps
 * 01–03) · 10419:276 (mission) · 10419:3537 (done) · 10412:2490 / 2602 (error states) ·
 * 10419:6147 (email copied) · 10419:6404 / 6622 (quick word, sent) ·
 * mobile 10419:5894 (cover) / 10419:5961 (start).
 * Screens switch in place (data-step on the block); one printer stands still on the right
 * (a placeholder for now) and the faint mono "system log" behind it retypes itself with new words on every screen — partly built
 * from the site's projects / episodes, partly from what the visitor has typed so far.
 * `embedded` = the pre-footer block on every page: opens straight on the start screen (the
 * three ways in show right away), never touches the URL.
 * On /contact it starts there too and keeps the step in the URL hash (so Back works).
 * Titles only: no lead lines under them, except on the two "sent" screens.
 * Send posts the answers to /api/contact (saved for the CMS "Contact form responses").
 */
import { getCollection } from 'astro:content';
import Icon from '../../components/icons/Icon.astro';
import { studio } from '../../data/site';

interface Props {
  /** The pre-footer block: steps don't change the URL */
  embedded?: boolean;
}
const { embedded = false } = Astro.props;
const Title = embedded ? 'h2' : 'h1';

// ── System log content: one set of groups per screen ─────────────────────────────────
const projects = (await getCollection('projects')).slice(0, 6);
const episodes = (await getCollection('episodes', (e) => e.data.listed !== false))
  .sort((a, b) => b.data.number - a.data.number)
  .slice(0, 3);
const positions = (await getCollection('positions')).sort((a, b) => a.data.order - b.data.order).slice(0, 1);

const up = (s: string) => s.toUpperCase();
const now = new Date();
const stamp = `${String(now.getMonth() + 1).padStart(2, '0')}${String(now.getDate()).padStart(2, '0')}${String(now.getFullYear()).slice(2)}`;
const project = (i: number) => {
  const p = projects[i % projects.length];
  return [`> ${up(p.data.name)}_`, ...p.data.services.slice(0, 2).map(up)];
};
const episode = (i: number) => {
  const e = episodes[i % episodes.length];
  return [`ROBO RADIO ${e.data.number}_`, up(e.data.guest)];
};
const role = positions[0];
const email = up(studio.email);

// Slots placed as in the Figma reference image (x, y in % of the log's box); `n` is the
// label, `m` the place on phones (groups without it are desktop only)
type Group = { x: number; y: number; n?: string; lines: string[]; m?: [number, number] };
type Slots = Partial<Record<'h1' | 'h2' | 'h3' | 'h4' | 'intro' | 'st' | 'a' | 'b' | 'c' | 'd' | 'e' | 'f' | 'g' | 'r1' | 'r2' | 'r3' | 'r4', string[]>>;
const SLOT: Record<keyof Slots, Omit<Group, 'lines'>> = {
  h1: { x: 2, y: 2 },
  h2: { x: 15, y: 2 },
  h3: { x: 40, y: 2 },
  h4: { x: 66, y: 2 },
  intro: { x: 22.5, y: 15, n: '002', m: [0, 0] },
  st: { x: 50, y: 15 },
  a: { x: 11, y: 25, n: '(A)', m: [0, 22] },
  b: { x: 11, y: 39, n: '(B)', m: [0, 50] },
  c: { x: 2, y: 49, n: '(C)', m: [0, 76] },
  d: { x: 2, y: 56, n: '(D)' },
  e: { x: 22.5, y: 64, n: '(E)' },
  f: { x: 41.5, y: 64, n: '(F)' },
  g: { x: 22.5, y: 83, n: '(G)' },
  // right part: the open strip right of the printer (no labels, it's narrow)
  r1: { x: 88, y: 12 },
  r2: { x: 88, y: 29 },
  r3: { x: 88, y: 46 },
  r4: { x: 88, y: 60 },
};
const groups = (s: Slots): Group[] =>
  (Object.keys(s) as (keyof Slots)[]).map((k) => ({ ...SLOT[k], lines: s[k]! }));

// {name} {email} {company} {services} are filled in from the form as the visitor goes
const logs: Record<string, { a: Group[]; b?: Group[] }> = {
  start: {
    a: groups({
      h1: ['[ HR'], h2: ['INCOMING SIGNAL'], h3: ['03 ]'], h4: ['CHANNELS: OPEN'],
      intro: ['HELLO ROBO®', 'CONTACT TERMINAL', stamp],
      st: ['Three ways in. Pick one —', 'we read everything, humans first.'],
      a: ['> START A PROJECT_', 'BRIEF IN 4 STEPS', '~2 MIN'], b: ['> QUICK WORD_', 'ONE FIELD', 'NO PRESSURE'],
      c: ['> COPY EMAIL_', email], d: ['RESPONSE TIME_', '< 24 H'], e: ['STATUS_', 'HUMANS: ONLINE', 'ROBOTS: STANDBY'],
      f: ['QUEUE_', 'EMPTY. YOUR TURN.'], g: ['> WAITING FOR INPUT_'],
      r1: ['CURIOSITY 98%', 'EGO 02%'], r2: ['TRUST_SYNCED', 'YES_PENDING'], r3: [up(`${studio.city} ${studio.region}`), 'EST'], r4: ['> SAY HELLO_'],
    }),
  },
  name: {
    a: groups({
      h1: ['[ 01'], h2: ['IDENTITY SCAN'], h3: ['04 ]'], h4: ['STEP 1 / 4'],
      intro: ['HUMAN DETECTED', 'NAME FIELD OPEN', stamp],
      st: ['Before we connect the dots —', 'identify the human.'],
      a: ['SCAN_', 'FACE: FRIENDLY', 'HANDS: 2'], b: ['ROLE_', 'FOUNDER?', 'ENGINEER?', 'DREAMER?'], c: ['NAME: {name}_'],
      d: ['ALIAS ACCEPTED', 'NICKNAMES OK'], e: ['CONFIDENCE_', 'HUMAN 99.8%', 'ROBOT 0.2%'], f: ['> NEXT: EMAIL_'], g: ['WAITING FOR INPUT_'],
    }),
  },
  email: {
    a: groups({
      h1: ['[ 02'], h2: ['ROUTING TABLE'], h3: ['04 ]'], h4: ['STEP 2 / 4'],
      intro: ['HELLO, {name}', 'DESTINATION UNKNOWN', stamp],
      st: ['Every good connection needs', 'a destination.'],
      a: ['PROTOCOL_', 'SMTP / HELLO', 'PORT 587'], b: ['ROUTE_', '{name} → HELLO ROBO'], c: ['ADDRESS: {email}_'],
      d: ['SPAM: NEVER', 'NEWSLETTER: NO'], e: ['PING_', '64 BYTES FROM HUMAN', 'TIME=1MS'], f: ['> NEXT: COMPANY_'], g: ['WAITING FOR @_'],
    }),
  },
  company: {
    a: groups({
      h1: ['[ 03'], h2: ['TEAM-UP REGISTRY'], h3: ['04 ]'], h4: ['STEP 3 / 4'],
      intro: ['{name}', '{email}', stamp],
      st: ['Startup, spaceship or', 'secret laboratory.'],
      a: ['CLASSIFY_', 'STARTUP', 'SPACESHIP', 'SECRET LAB'], b: ['JUDGEMENT_', 'DISABLED'], c: ['COMPANY: {company}_'],
      d: ['NDA: AVAILABLE', 'STEALTH: RESPECTED'], e: ['FLEET SIZE_', '1 → 10,000 ROBOTS'], f: ['> NEXT: MISSION_'], g: ['WAITING FOR INPUT_'],
    }),
  },
  mission: {
    a: groups({
      h1: ['[ 04'], h2: ['MISSION BRIEF'], h3: ['04 ]'], h4: ['STEP 4 / 4'],
      intro: ['{company}', 'PRIORITY: HIGH', stamp],
      st: ['Pick as many as you like —', 'all three live under one roof.'],
      a: ['> BRAND IDENTITY_', 'NAMING', 'IDENTITY', 'TONE OF VOICE'], b: ['> UI/UX_', 'HRI', 'FLEET UI', 'DASHBOARDS'],
      c: ['> VIDEO PRODUCTION_', 'LAUNCH FILMS', 'DEMOS'], d: ['SELECTED: {services}'], e: ['BUDGET_', "LET'S TALK"],
      f: ['TIMELINE_', 'YESTERDAY?'], g: ['> READY TO SUBMIT_'],
    }),
  },
  message: {
    a: groups({
      h1: ['[ HR'], h2: ['OPEN CHANNEL'], h3: ['01 ]'], h4: ['QUICK WORD'],
      intro: ['ONE FIELD', 'NO FORMS', stamp],
      st: ["Don't overthink it.", 'Just type away.'],
      a: ['> MESSAGE_', 'LENGTH: ANY'], b: ['TONE_', 'CASUAL OK', 'WEIRD OK'], c: ['READ BY_', 'A REAL HUMAN'],
      d: ['REPLY_', '< 24 H'], e: ['ENCRYPTION_', 'HANDWRITTEN-GRADE'], f: ['> SEND_'], g: ['WAITING FOR WORDS_'],
    }),
  },
  done: {
    a: groups({
      h1: ['[ OK'], h2: ['TRANSMISSION COMPLETE'], h3: ['✓ ]'], h4: ['RECEIPT #321'],
      intro: ['THANKS, {name}', '{company}', stamp],
      st: ['Your message has landed safely.', 'Our humans are on it.'],
      a: ['HUMANS_', 'NOTIFIED'], b: ['ROBOTS_', 'PRETENDING TO HELP'], c: ['STATUS_', 'YES_PENDING → YES'],
      d: ['ARCHIVED BY', 'HUMAN INPUT CONFIRMED'], e: ['> WE BUILD FOR', 'WHO MOVES NEXT_'], f: ['REPLY_', '< 24 H'], g: ['KEEP THIS RECEIPT_', "OR DON'T. WE HAVE A COPY."],
    }),
    b: groups({
      h2: ['SIGNAL RECEIVED'], h3: ['OK ]'], h4: ['CONNECTION ESTABLISHED'],
      intro: ['{name}', '{email}', '{company}'],
      st: ['Your message is in good hands.', 'Human hands, actually.'],
      a: ['SELECTED_', '{services}'], b: ['QUEUE_', 'POSITION #1'], c: ['NEXT_', 'A REAL HUMAN REPLIES'],
      d: ['YOUR ROBOT', 'REMAINS CALM'], e: ['> SEE YOU SOON_'],
    }),
  },
};

logs.sent = {
  a: groups({
    h1: ['[ OK'], h2: ['MESSAGE DELIVERED'], h3: ['✓ ]'], h4: ['QUICK WORD'],
    intro: ['HI RECEIVED', 'MOOD: DELIGHTED', stamp],
    st: ['Your message is on its way', 'to a real human.'],
    a: ['HUMANS_', 'READING'], b: ['ROBOTS_', 'WAVING BACK'], c: ['STATUS_', 'HELLO → HELLO'],
    d: ['REPLY_', '< 24 H'], e: ['> WE LIKE THOSE', 'AROUND HERE_'], f: ['CHANNEL_', 'STILL OPEN'], g: ['SAY HI AGAIN_', 'ANYTIME'],
  }),
  b: logs.done.b,
};

const steps = [
  { id: 'name', title: 'Who’s on the other side?', field: 'Your name', type: 'text', auto: 'name', cap: 'words', back: 'start' },
  { id: 'email', title: 'What’s your email?', field: 'Your email', type: 'email', auto: 'email', cap: 'off', back: 'name' },
  { id: 'company', title: 'Who are we teaming up with?', field: 'Company name', type: 'text', auto: 'organization', cap: 'words', back: 'email' },
];
const services = [
  { label: 'Brand identity', sticker: 'mission-branding', w: 74, h: 75, x: 309, y: 50 },
  { label: 'UI/UX', sticker: 'mission-interface', w: 76, h: 68, x: 307, y: 53 },
  { label: 'Video production', sticker: 'mission-video', w: 87, h: 52, x: 295, y: 68 },
];
---
<section
  class:list={['contact', embedded && 'contact--embedded']}
  aria-label="Contact"
  data-contact={embedded ? 'embedded' : 'page'}
  data-step="start"
>
  <!-- Background: the printer and the system log -->
  <div class="contact__bg" aria-hidden="true">
    <div class="contact__log contact__log--a" data-log="a"></div>
    <div class="contact__log contact__log--b" data-log="b"></div>
    <!-- Desktop: the RCPT-01 printer as a live 3D model (src/scripts/printer-3d.ts); nothing
         shows there if WebGL or the model fails -->
    <div class="contact__printer-3d" data-printer-3d></div>
  </div>

  <!-- Start: three ways in -->
  <div class="contact__screen contact__screen--start" data-step="start" data-active>
    <Title class="contact__title t-h2">Is the world ready<br />for your robot?</Title>
    <div class="contact__cards">
      <a class="contact__card contact__card--light" href="#name" data-go="name">
        <span class="t-body">Start a project</span>
        <img class="contact__card-sticker" src="/images/contact/start-project.svg" alt="" width="165" height="54" style="--x: 219; --y: 65; --w: 165; --mx: 179; --my: 51" loading="lazy" />
      </a>
      <a class="contact__card" href="#message" data-go="message">
        <span class="t-body">Drop a quick word</span>
        <img class="contact__card-sticker" src="/images/contact/start-word.svg" alt="" width="148" height="140" style="--x: 254; --y: -4; --w: 148; --mx: 226; --my: -5; --mw: 131" loading="lazy" />
      </a>
      <button class="contact__card contact__card--copy" type="button" data-copy={studio.email}>
        <span class="t-body"><span data-copy-label>Just wanna copy email</span><img class="contact__smiley" src="/images/contact/start-email-smiley.svg" alt="" width="36" height="27" loading="lazy" /></span>
        <span class="contact__card-email t-body">{studio.email}</span>
        <img class="contact__card-sticker" src="/images/contact/start-email.svg" alt="" width="152" height="66" style="--x: 244; --y: 65; --w: 152; --mx: 223; --my: 49; --mw: 132" loading="lazy" />
        <!-- "Email copied" (10419:6147): a pixel dinosaur runs along the card -->
        <span class="contact__dino" aria-hidden="true"><img src="/images/contact/dino.svg" alt="" width="22" height="28" /></span>
      </button>
    </div>
  </div>

  <!-- Name · Email · Company -->
  {steps.map((s) => (
    <form class="contact__screen contact__screen--step" data-step={s.id} action="#" novalidate>
      <h2 class="contact__title t-h2">{s.title}</h2>
      <div class="contact__field">
        <label class="visually-hidden" for={`contact-${s.id}`}>{s.field}</label>
        <input class="contact__input t-body" id={`contact-${s.id}`} type={s.type} name={s.id} placeholder={s.field} autocomplete={s.auto} autocapitalize={s.cap} autocorrect="off" spellcheck="false" enterkeyhint="next" />
        <p class="contact__error" role="alert" data-error></p>
      </div>
      <a class="contact__back t-button" href={`#${s.back}`} data-go={s.back}>Go back <Icon name="undo" /></a>
      <button class="contact__submit contact__submit--next t-button" type="submit">Next <Icon name="next" /></button>
    </form>
  ))}

  <!-- Mission -->
  <form class="contact__screen contact__screen--step contact__screen--mission" data-step="mission" action="#" novalidate>
    <h2 class="contact__title t-h2">What’s the mission?</h2>
    <fieldset class="contact__cards">
      <legend class="visually-hidden">Services</legend>
      {services.map((s) => (
        <label class="contact__card contact__card--check">
          <input type="checkbox" name="services" value={s.label} />
          <span class="t-body">{s.label}</span>
          <img class="contact__card-sticker" src={`/images/contact/${s.sticker}.svg`} alt="" width={s.w} height={s.h} style={`--x: ${s.x}; --y: ${s.y}; --w: ${s.w}`} loading="lazy" />
        </label>
      ))}
    </fieldset>
    <p class="contact__error contact__error--send" role="alert" data-error></p>
    <input class="contact__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <a class="contact__back t-button" href="#company" data-go="company">Go back <Icon name="undo" /></a>
    <button class="contact__submit t-button" type="submit" data-send="project">Submit <Icon name="hex" /></button>
  </form>

  <!-- Quick word -->
  <!-- Quick word (10419:6404): title, the field; Go back + Submit along the bottom -->
  <form class="contact__screen contact__screen--message" data-step="message" action="#" novalidate>
    <h2 class="contact__title t-h2">We’re all ears. Well, sort of. Drop your message below</h2>
    <div class="contact__field">
      <label class="visually-hidden" for="contact-message">Your message</label>
      <textarea class="contact__input contact__textarea t-body" id="contact-message" name="message" rows="1" autocapitalize="sentences" placeholder="Don’t overthink it. Just type away..."></textarea>
      <p class="contact__error" role="alert" data-error></p>
    </div>
    <input class="contact__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <a class="contact__back t-button" href="#start" data-go="start">Go back <Icon name="undo" /></a>
    <button class="contact__submit contact__submit--next t-button" type="submit" data-send="message">Submit <Icon name="hex" /></button>
  </form>

  <!-- Done -->
  <div class="contact__screen contact__screen--done" data-step="done">
    <h2 class="contact__title t-h2">Beep boop.<br />We got you.</h2>
    <p class="contact__lead t-body">Your message has landed safely. Our humans are on it. Our robots are pretending to help.</p>
  </div>

  <!-- Quick word sent (10419:6622) -->
  <div class="contact__screen contact__screen--done" data-step="sent">
    <h2 class="contact__title t-h2">Hey, thanks for saying hi.</h2>
    <p class="contact__lead t-body">Your message is on its way to a real human. We like those around here.</p>
  </div>

  <script type="application/json" data-logs set:html={JSON.stringify(logs)} />
</section>

<script>
  import { sfx } from '../../scripts/sound';
  import { blinkLogo } from '../../scripts/robo-logo';

  type Group = { x: number; y: number; n?: string; lines: string[]; m?: [number, number] };
  type Logs = Record<string, { a: Group[]; b?: Group[] }>;

  // The 3D printer: desktop with a mouse only, fetched once the block is near the screen.
  // Each block's printer, once it's up, so a sent brief can print its receipt
  type Printer = { print: (receipt: HTMLCanvasElement) => void };
  const printers = new WeakMap<HTMLElement, Printer>();
  for (const host of document.querySelectorAll<HTMLElement>('[data-printer-3d]')) {
    if (!matchMedia('(min-width: 1024px) and (hover: hover) and (pointer: fine)').matches) break;
    const block = host.closest<HTMLElement>('.contact');
    const near = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        near.disconnect();
        import('../../scripts/printer-3d')
          .then(({ mountPrinter }) => {
            const printer = mountPrinter({ host, className: 'contact__printer-canvas' });
            if (printer && block) printers.set(block, printer);
          })
          .catch(() => {});
      },
      { rootMargin: '600px 0px' },
    );
    near.observe(host);
  }

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Wraps every word of `el` in spans (for the title rise and the lead light-up) */
  function splitWords(el: HTMLElement, wrap: (word: HTMLElement) => Node, wordClass: string) {
    let n = 0;
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    const texts: Text[] = [];
    for (let t = walker.nextNode(); t; t = walker.nextNode()) texts.push(t as Text);
    for (const text of texts) {
      const frag = document.createDocumentFragment();
      for (const part of text.nodeValue!.split(/( +)/)) {
        if (!part) continue;
        if (/^ +$/.test(part)) {
          frag.append(part);
          continue;
        }
        const w = document.createElement('span');
        w.className = wordClass;
        w.style.setProperty('--d', String(n++));
        w.textContent = part;
        frag.append(wrap(w));
      }
      text.replaceWith(frag);
    }
  }

  /** Titles move as on the Services scroller and the works wheel: every word sits in a mask;
   *  on a screen change the old title's words slide out of their masks and the new one's
   *  slide in after them — up when going on, down when going back (data-state next /
   *  current / past). The lead lights up word by word (like the reading text) */
  function prepareText(root: HTMLElement) {
    if (reduced) return;
    root.querySelectorAll<HTMLElement>('.contact__title').forEach((t) => {
      splitWords(t, (w) => {
        const mask = document.createElement('span');
        mask.className = 'hl-mask';
        mask.append(w);
        return mask;
      }, 'ct-word');
      t.classList.add('ct-ready');
      t.dataset.state = 'next';
    });
    root.querySelectorAll<HTMLElement>('.contact__lead').forEach((l) => {
      splitWords(l, (w) => w, 'cr-word');
      l.classList.add('cr-ready');
    });
  }
  /** `screen`'s title comes in from below (dir 1) or above (-1); `from`'s goes out the other way */
  function playText(screen: HTMLElement, from?: HTMLElement | null, dir = 1) {
    const out = from?.querySelector<HTMLElement>('.contact__title.ct-ready');
    if (out && from !== screen) out.dataset.state = dir > 0 ? 'past' : 'next';
    const title = screen.querySelector<HTMLElement>('.contact__title.ct-ready');
    if (title) {
      // start on the side it comes from, without moving there
      title.classList.add('is-placing');
      title.dataset.state = dir > 0 ? 'next' : 'past';
      void title.offsetWidth;
      title.classList.remove('is-placing');
      title.dataset.state = 'current';
    }
    const leads = screen.querySelectorAll<HTMLElement>('.contact__lead.cr-ready');
    leads.forEach((p) => p.classList.remove('is-in'));
    void screen.offsetWidth;
    leads.forEach((p) => p.classList.add('is-in'));
  }
  /** how deep each screen is: going to a deeper one moves the titles up, back moves them down */
  const DEPTH: Record<string, number> = { start: 0, name: 1, message: 1, email: 2, sent: 2, company: 3, mission: 4, done: 5 };
  const phone = matchMedia('(max-width: 1023px)');

  /** The faint mono log in one box: shows a screen's groups and types them out line by
   *  line while the block is on screen; once done it rests, then rewrites a few lines. */
  function typewriter(box: HTMLElement) {
    let lines: HTMLElement[] = [];
    let queue: HTMLElement[] = [];
    let line: HTMLElement | undefined;
    let pos = 0;
    let rest = 0;
    let timer = 0;
    let visible = false;

    const tick = () => {
      if (rest > 0) return void rest--;
      if (!line) {
        line = queue.shift();
        pos = 0;
        if (!line) {
          // all written: rest ~4s, then clear and rewrite three random lines
          rest = 100;
          queue = [...lines].sort(() => Math.random() - 0.5).slice(0, 3);
          queue.forEach((l) => (l.textContent = ''));
          return;
        }
      }
      const full = line.dataset.text ?? '';
      pos = Math.min(full.length, pos + 2 + Math.floor(Math.random() * 3));
      line.textContent = full.slice(0, pos);
      line.classList.add('is-typing');
      if (pos >= full.length) {
        line.classList.remove('is-typing');
        line = undefined;
        rest = 1 + Math.floor(Math.random() * 4);
      }
    };
    const run = () => {
      clearInterval(timer);
      if (visible && !reduced) timer = window.setInterval(tick, 40);
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      run();
    }).observe(box);

    return (groups: Group[] = []) => {
      box.replaceChildren(
        ...groups.map((g) => {
          const el = document.createElement('div');
          el.className = 'contact__group' + (g.m ? '' : ' contact__group--desktop');
          el.style.cssText = `--x:${g.x}%;--y:${g.y}%` + (g.m ? `;--mx:${g.m[0]}%;--my:${g.m[1]}%` : '');
          if (g.n) {
            const n = document.createElement('span');
            n.textContent = g.n;
            el.append(n);
          }
          const col = document.createElement('span');
          col.className = 'contact__lines';
          for (const text of g.lines) {
            const l = document.createElement('span');
            l.className = 'contact__line';
            l.dataset.text = text;
            l.textContent = reduced ? text : '';
            col.append(l);
          }
          el.append(col);
          return el;
        }),
      );
      // groups hidden on this screen size are skipped
      lines = [...box.querySelectorAll<HTMLElement>('.contact__line')].filter((l) => !phone.matches || l.closest('.contact__group:not(.contact__group--desktop)'));
      queue = [...lines];
      line = undefined;
      rest = 0;
      run();
    };
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-contact]')) {
    const embedded = root.dataset.contact === 'embedded';
    prepareText(root);
    // the first screen's words play when the block first comes into view (it sits at the
    // bottom of the page); after that, on every screen change
    let seen = false;
    const firstView = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      seen = true;
      firstView.disconnect();
      const current = root.querySelector<HTMLElement>('.contact__screen[data-active]');
      if (current) playText(current);
    }, { rootMargin: '0px 0px -15% 0px' });
    firstView.observe(root);
    const screens = [...root.querySelectorAll<HTMLElement>('.contact__screen')];
    // Desktop: Go back + Next / Submit sit 80 under the field's line (CSS: .has-field-line),
    // following it down as the message box grows. Measured in the screen's own units
    // (offsets ignore the screens' entrance translate)
    const lines = new ResizeObserver((entries) => {
      for (const { target } of entries) {
        const input = target as HTMLElement;
        const fieldBox = input.offsetParent as HTMLElement | null;
        const screen = input.closest<HTMLElement>('.contact__screen');
        if (!fieldBox || !screen) continue;
        screen.style.setProperty('--field-line', `${fieldBox.offsetTop + input.offsetTop + input.offsetHeight}px`);
        screen.classList.add('has-field-line');
      }
    });
    for (const input of root.querySelectorAll<HTMLElement>('.contact__field .contact__input')) lines.observe(input);
    const logs: Logs = JSON.parse(root.querySelector('[data-logs]')?.textContent ?? '{}');
    const write = { a: typewriter(root.querySelector('[data-log=a]')!), b: typewriter(root.querySelector('[data-log=b]')!) };
    const field = (id: string) => root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#contact-${id}`)!;
    const value = (id: string) => field(id)?.value.trim() ?? '';
    const chosen = () => [...root.querySelectorAll<HTMLInputElement>('input[name=services]:checked')].map((i) => i.value);

    /** The log groups of `step`, with what the visitor has typed filled in */
    const fill = (groups: Group[] = []) => {
      const data: Record<string, string> = {
        name: value('name'),
        email: value('email'),
        company: value('company'),
        services: chosen().join(' / '),
      };
      return groups.map((g) => ({
        ...g,
        lines: g.lines.map((l) => l.replace(/\{(\w+)\}/g, (_, k) => (data[k] || '—').toUpperCase())),
      }));
    };

    let homeTimer = 0;

    // Phones and tablets: no focusing a field for the visitor. Its keyboard opening made the
    // page scroll to the field while the screens were still changing over (a jump to
    // another part of the page); there they tap the field to type
    const touch = matchMedia('(pointer: coarse)').matches;

    /** Shows screen `step` (the first one for an empty / unknown step) */
    function show(step: string, focus = !touch) {
      const target = screens.find((s) => s.dataset.step === step) ?? screens[0];
      const id = target.dataset.step!;
      const prev = root.dataset.shown ? screens.find((s) => s.dataset.step === root.dataset.step) : null;
      const dir = (DEPTH[id] ?? 0) >= (DEPTH[prev?.dataset.step ?? ''] ?? 0) ? 1 : -1;
      if (root.dataset.step !== id || !root.dataset.shown) {
        root.dataset.step = id;
        root.dataset.shown = 'true';
        for (const s of screens) {
          s.toggleAttribute('data-active', s === target);
          s.inert = s !== target;
        }
        write.a(fill(logs[id]?.a));
        write.b(fill(logs[id]?.b));
        if (seen) playText(target, prev, dir);
        // after "Beep boop" / "thanks for saying hi", the block goes back to its first screen
        clearTimeout(homeTimer);
        if (id === 'done' || id === 'sent') homeTimer = window.setTimeout(() => go('start'), 6000);
      }
      if (focus) target.querySelector<HTMLElement>('.contact__input')?.focus({ preventScroll: true });
    }

    /** Goes to `step`: on /contact through the URL hash (so Back works), in the block in place */
    function go(step: string) {
      if (embedded) return show(step);
      const hash = step === 'start' ? '' : `#${step}`;
      if (location.hash === hash || (!hash && !location.hash)) show(step);
      else location.hash = hash;
    }

    if (embedded) {
      show('start', false);
      // other places on the page can open a step: dispatch "contact:show" with its name
      root.addEventListener('contact:show', (e) => show((e as CustomEvent<string>).detail));
      // "Get in touch" links don't leave the page when it has this block: the page glides
      // down to the block and it opens on the start. The menu's "Get in touch" is the
      // exception: it goes to the /contact page
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href="/contact"]');
        if (!link || root.contains(link) || link.closest('#site-menu') || e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        show('start');
        root.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    } else {
      show(location.hash.slice(1), false);
      addEventListener('hashchange', () => show(location.hash.slice(1)));
    }

    // Cards, Go back: data-go switches screens
    root.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLElement>('[data-go]');
      if (!link) return;
      e.preventDefault();
      go(link.dataset.go!);
    });
    // Esc steps back
    root.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const back = root.querySelector<HTMLElement>('.contact__screen[data-active] .contact__back');
      if (back) go(back.dataset.go!);
    });

    // Errors: orange line and message under the field, cleared as soon as they type
    const setError = (form: HTMLElement, text: string) => {
      const out = form.querySelector<HTMLElement>('[data-error]');
      if (out) out.textContent = text;
      if (text) {
        sfx('error');
        blinkLogo();
      }
      form.classList.toggle('has-error', !!text);
    };
    const check: Record<string, () => string> = {
      name: () => {
        const v = value('name');
        if (!v) return 'Please tell us your name';
        if (/\d/.test(v)) return 'Name can’t contain numbers';
        return '';
      },
      email: () => {
        const v = value('email');
        if (!v) return 'Where should we write back?';
        if (!v.includes('@')) return 'Email is missing an @';
        if (!EMAIL_RE.test(v)) return 'That email doesn’t look right';
        return '';
      },
      company: () => '',
      message: () => (value('message') ? '' : 'Write a few words first'),
    };
    const nextOf: Record<string, string> = { name: 'email', email: 'company', company: 'mission' };

    for (const form of root.querySelectorAll<HTMLFormElement>('form')) {
      const step = form.dataset.step!;
      const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>('.contact__input');
      // the arrow is dimmed until there is something to send on
      const sync = () => form.classList.toggle('is-filled', !!input?.value.trim());
      // autofill may fill the field without an input event: check on change and on load too
      input?.addEventListener('change', sync);
      setTimeout(sync, 600);
      input?.addEventListener('input', () => {
        sync();
        if (form.classList.contains('has-error')) setError(form, '');
        if (input instanceof HTMLTextAreaElement) {
          input.style.height = 'auto';
          input.style.height = `${input.scrollHeight}px`;
        }
      });
      // Enter in the message adds a line; Cmd/Ctrl+Enter sends
      if (input instanceof HTMLTextAreaElement) {
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) form.requestSubmit();
        });
      }
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (nextOf[step]) {
          const err = check[step]();
          setError(form, err);
          if (err) return touch ? undefined : input?.focus({ preventScroll: true });
          go(nextOf[step]);
        } else {
          send(form);
        }
      });
    }

    // Mission cards: the log picks up the choice
    root.querySelectorAll<HTMLInputElement>('input[name=services]').forEach((box) =>
      box.addEventListener('change', () => {
        root.querySelectorAll<HTMLElement>('[data-log=a] .contact__line[data-text^="SELECTED:"]').forEach(
          (d) => (d.dataset.text = d.textContent = `SELECTED: ${(chosen().join(' / ') || '—').toUpperCase()}`),
        );
      }),
    );

    // "Just wanna copy email": puts the address on the clipboard, the card says "Email
    // copied" while the pixel dinosaur runs across it once — on the way it jumps and bumps
    // the address from below (Mario and the block): the address hops and turns orange, the
    // dinosaur lands and runs on, out past the card's edge. Then the card is back
    const RUN = 1800;
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      const text = label?.textContent;
      const dino = btn.querySelector<HTMLElement>('.contact__dino');
      const address = btn.querySelector<HTMLElement>('.contact__card-email');
      let timer = 0;
      let bumpTimer = 0;
      let moves: Animation[] = [];
      const run = () => {
        moves.forEach((a) => a.cancel());
        moves = [];
        clearTimeout(bumpTimer);
        address?.classList.remove('is-bumped');
        if (!dino || !address) return;
        if (reduced) return address.classList.add('is-bumped');
        // measured from where the dinosaur starts (bottom left): how far it runs, where the
        // address's middle is along the way, and how high it jumps to touch its underside
        const card = btn.getBoundingClientRect();
        const d = dino.getBoundingClientRect();
        const a = address.getBoundingClientRect();
        // all the way out past the card's right edge: the card clips it, so it runs off and hides
        const dist = card.right - d.left;
        const hit = Math.min(0.8, Math.max(0.1, (a.left + a.width * 0.45 - (d.left + d.width / 2)) / dist));
        const jump = a.bottom - d.top + 1; // px, negative: up
        // pixel steps, like the sprite
        moves.push(dino.animate([{ translate: '0 0' }, { translate: `${dist}px 0` }], { duration: RUN, easing: 'steps(24)', fill: 'both' }));
        moves.push(
          dino.animate(
            [
              { offset: 0, transform: 'none', easing: 'steps(1)' },
              { offset: hit - 0.09, transform: 'none', easing: 'steps(1)' },
              { offset: hit - 0.045, transform: `translateY(${jump * 0.6}px)`, easing: 'steps(1)' },
              { offset: hit, transform: `translateY(${jump}px)`, easing: 'steps(1)' },
              { offset: hit + 0.045, transform: `translateY(${jump * 0.6}px)`, easing: 'steps(1)' },
              { offset: hit + 0.09, transform: 'none', easing: 'steps(1)' },
              { offset: 1, transform: 'none' },
            ],
            // the pixel steps inside each part of the jump (an easing here would step the whole run)
            { duration: RUN, fill: 'both' },
          ),
        );
        // the bump: the address hops up a little as the head hits it, and stays orange
        moves.push(
          address.animate(
            [{ transform: 'none', easing: 'steps(1)' }, { transform: 'translateY(-0.22em)', easing: 'steps(1)' }, { transform: 'none' }],
            { duration: 240, delay: RUN * hit },
          ),
        );
        bumpTimer = window.setTimeout(() => address.classList.add('is-bumped'), RUN * hit);
      };
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy!);
        } catch {
          // no clipboard access (old browser / not https): open the mail app instead
          location.href = `mailto:${btn.dataset.copy}`;
          return;
        }
        if (label) label.textContent = 'Email copied';
        // a second click restarts the run
        btn.classList.remove('is-copied');
        void btn.offsetWidth;
        btn.classList.add('is-copied');
        run();
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (label) label.textContent = text!;
          btn.classList.remove('is-copied');
          address?.classList.remove('is-bumped');
          moves.forEach((a) => a.cancel());
        }, RUN + 300);
      });
    });

    /** Sends the project brief or the quick word; a missing answer opens its step */
    async function send(form: HTMLFormElement) {
      const button = form.querySelector<HTMLButtonElement>('[data-send]')!;
      if (button.ariaBusy === 'true') return;
      const type = button.dataset.send as 'project' | 'message';
      let body: Record<string, unknown>;
      if (type === 'project') {
        for (const step of ['name', 'email']) {
          const err = check[step]();
          if (err) {
            const target = root.querySelector<HTMLElement>(`form[data-step=${step}]`)!;
            setError(target, err);
            return go(step);
          }
        }
        body = { type, name: value('name'), email: value('email'), company: value('company'), services: chosen() };
      } else {
        const err = check.message();
        setError(form, err);
        if (err) return;
        body = { type, message: value('message') };
      }
      body.page = location.pathname;
      body.website = form.querySelector<HTMLInputElement>('.contact__trap')?.value;

      button.ariaBusy = 'true';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const reply = await res.json().catch(() => null);
        if (!res.ok) throw new Error(reply?.error ?? 'Something went wrong');
        setError(form, '');
        // a project brief prints its receipt (desktop, once the printer is up)
        const printer = printers.get(root);
        if (type === 'project' && printer) {
          import('../../scripts/receipt')
            .then(({ drawReceipt }) =>
              drawReceipt({
                number: Number(reply?.number) || 1,
                name: String(body.name ?? ''),
                company: String(body.company ?? ''),
                services: body.services as string[],
              }),
            )
            .then((receipt) => printer.print(receipt))
            .catch(() => {});
        }
        go(type === 'message' ? 'sent' : 'done');
        sfx('success');
        // the done screen's log has used the answers; the forms are cleared
        // once the block has gone back to its first screen
        setTimeout(() => {
          root.querySelectorAll<HTMLFormElement>('form').forEach((f) => {
            f.reset();
            f.classList.remove('is-filled');
          });
        }, 7000);
      } catch (err) {
        setError(form, `Couldn’t send: ${(err as Error).message}. Please try again or email info@hellorobo.co`);
      } finally {
        button.ariaBusy = 'false';
      }
    }
  }
</script>

<style>
  /* Figma 1728×949, plain light grey (grey-100) with black text. All positions are Figma px
     (var(--px) = 1/1728 of the width) */
  .contact {
    --ease-move: cubic-bezier(0.65, 0, 0.35, 1);
    position: relative;
    width: 100%;
    aspect-ratio: 1728 / 949;
    /* grey-100 (#f2f2f2) taken 10% lighter, towards white */
    background: color-mix(in srgb, var(--color-grey-100), white 10%);
    color: var(--color-black);
    overflow: hidden;
  }
  /* On /contact it's the whole page */
  .contact:not(.contact--embedded) {
    min-height: 100vh;
    min-height: 100svh;
  }
  .contact__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ── System log: the mono text behind the printers (hidden: the grey stays clean) ── */
  .contact__log {
    display: none;
    position: absolute;
    left: calc(var(--lx) * var(--px));
    top: calc(var(--ly) * var(--px));
    width: calc(1319 * var(--px));
    height: calc(771 * var(--px));
    font-family: var(--font-mono);
    font-size: calc(15 * var(--px));
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: var(--color-black);
    opacity: 0.4;
    white-space: nowrap;
    /* a little out of focus, like the far printer */
    filter: blur(max(1px, calc(1.6 * var(--px))));
    transition:
      left 0.9s var(--ease-move),
      top 0.9s var(--ease-move),
      opacity 0.5s ease;
  }
  /* start: Figma 338, 376; the form screens: 800, 321 */
  .contact__log--a {
    --lx: 338;
    --ly: 376;
  }
  .contact:is([data-step='name'], [data-step='email'], [data-step='company'], [data-step='mission'], [data-step='done'], [data-step='sent']) .contact__log--a {
    --lx: 800;
    --ly: 321;
  }
  /* a second log, bottom left, only once it's sent */
  .contact__log--b {
    --lx: -82;
    --ly: 475;
    opacity: 0;
  }
  .contact:is([data-step='done'], [data-step='sent']) .contact__log--b {
    opacity: 0.4;
  }
  .contact__log :global(.contact__group) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    gap: 2.2em;
  }
  .contact__log :global(.contact__lines) {
    display: flex;
    flex-direction: column;
  }
  /* each line keeps its height while empty, so groups don't jump as they type */
  .contact__log :global(.contact__line) {
    min-height: 1.3em;
  }
  .contact__log :global(.contact__line.is-typing)::after {
    content: '_';
    animation: contact-blink 0.8s steps(1) infinite;
  }
  @keyframes contact-blink {
    50% {
      opacity: 0;
    }
  }


  /* The 3D printer: the right part of the block, behind the screens, raised 130 (its top
     is cut off by the block's edge) */
  .contact__printer-3d {
    position: absolute;
    left: calc(860 * var(--px));
    top: calc(-130 * var(--px));
    right: 0;
    bottom: calc(130 * var(--px));
  }
  /* (its height is set by the script: on down to the block's bottom) */
  .contact__printer-3d :global(.contact__printer-canvas) {
    display: block;
    width: 100%;
    animation: contact-printer-in 0.8s ease both;
  }
  @keyframes contact-printer-in {
    from {
      opacity: 0;
    }
  }

  /* ── Screens: one at a time, fading over each other ── */
  .contact__screen {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(30 * var(--px));
    padding: var(--space-40);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s ease,
      visibility 0s linear 0.45s;
  }
  .contact__screen[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s ease 0.15s;
  }
  /* the words rise in a little after the screen appears */
  .contact__screen > * {
    transition: translate 0.7s var(--ease-move);
  }
  /* (titles and leads have their own word-by-word entrance, below) */
  .contact__screen:not([data-active]) > :is(.contact__cards, .contact__field) {
    translate: 0 calc(24 * var(--px));
  }

  .contact__title {
    width: calc(844 * var(--px));
    max-width: 100%;
  }
  .contact__lead {
    width: calc(442 * var(--px));
    max-width: 100%;
  }
  .contact__screen--start .contact__title {
    width: calc(1020 * var(--px));
  }
  .contact__screen--start .contact__lead {
    width: calc(402 * var(--px));
  }

  /* Form screens: [01] at 40, title at 94, lead 30 under it (Figma) */
  .contact__screen--step,
  .contact__screen--done {
    gap: 0;
  }
  .contact__screen--step .contact__title,
  .contact__screen--done .contact__title {
    width: calc(680 * var(--px));
    margin-top: calc(30 * var(--px));
  }
  .contact__screen--step .contact__lead {
    width: calc(402 * var(--px));
    margin-top: calc(30 * var(--px));
  }
  .contact__screen--done .contact__title {
    margin-top: calc(54 * var(--px));
  }
  .contact__screen--done .contact__lead {
    width: calc(378 * var(--px));
    margin-top: calc(30 * var(--px));
  }

  /* ── Titles: as the Services scroller / works wheel — each word slides through its mask;
     the outgoing title's words leave at once, the incoming ones follow a beat later ── */
  .ct-ready :global(.ct-word) {
    display: inline-block;
    translate: 0 var(--y, 0);
    transition: translate var(--duration-smooth) var(--ease-out);
    transition-delay: calc(0.12s + var(--d, 0) * var(--stagger));
  }
  .ct-ready[data-state='next'] :global(.ct-word) {
    --y: 135%;
    transition-delay: 0s;
  }
  .ct-ready[data-state='past'] :global(.ct-word) {
    --y: -135%;
    transition-delay: 0s;
  }
  .ct-ready.is-placing :global(.ct-word) {
    transition: none;
  }
  /* the outgoing screen stays up while its words slide out, then goes */
  .contact__screen:not([data-active]) {
    transition:
      opacity 0.35s ease 0.25s,
      visibility 0s linear 0.6s;
  }

  /* Lead text: words light up dim → full one after another as the screen opens */
  .cr-ready :global(.cr-word) {
    opacity: 0.15;
  }
  .cr-ready.is-in :global(.cr-word) {
    opacity: 1;
    transition: opacity 0.5s ease;
    transition-delay: calc(0.35s + var(--d) * 40ms);
  }

  /* ── Cards (start screen and mission): 402×140, 10 apart, from y 350 / 288 ── */
  .contact__cards {
    position: absolute;
    left: var(--space-40);
    top: calc(350 * var(--px));
    display: grid;
    gap: calc(10 * var(--px));
    margin: 0;
    padding: 0;
    border: 0;
  }
  .contact__screen--mission .contact__cards {
    top: calc(288 * var(--px));
  }
  /* flex, top-left: a <button> (the copy card) would otherwise centre its label vertically */
  .contact__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    width: calc(402 * var(--px));
    height: calc(140 * var(--px));
    padding: calc(20 * var(--px));
    overflow: hidden;
    /* plain grey, no glass */
    background: var(--color-grey-300);
    color: var(--color-black);
    text-align: left;
    font: inherit;
    border: 0;
    /* the site's button corners */
    border-radius: var(--radius-ui);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      color 0.25s ease;
  }
  .contact__card--light,
  .contact__card--check:has(input:checked) {
    background: var(--color-white);
    color: var(--color-black);
  }
  /* hover only with a mouse — on a phone it would stay "stuck" after the tap (a deselected
     mission card would keep looking half-selected); a tap gets a press state instead */
  @media (hover: hover) {
    /* every card and button: the words turn orange (set on the words themselves, which
       have no colour transition: the pixel hover reads the colour the moment it starts;
       not while it shows its pixels, which hide the words — this rule would outrank that) */
    .contact__card:hover > .t-body:not(.is-pixel),
    .contact__back:hover,
    .contact__submit:hover {
      color: var(--color-orange);
    }
  }
  .contact__card:active > .t-body:not(.is-pixel),
  .contact__back:active,
  .contact__submit:active {
    color: var(--color-orange);
  }

  /* Phone browser defaults off: the blue / grey tap flash, double-tap zoom delay, iOS
     input and button styling, long-press text selection / image menu on the controls */
  .contact :is(a, button, label, input, textarea) {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .contact :is(.contact__input, button) {
    -webkit-appearance: none;
    appearance: none;
  }
  .contact :is(.contact__card, .contact__back, .contact__submit) {
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
