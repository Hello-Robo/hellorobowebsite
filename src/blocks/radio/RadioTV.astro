---
/**
 * Robo Radio — TV player
 * Figma: Robo Radio "1 hero" (10105:275, 1730×983) and Episode player (10105:2825, 1730×872)
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-275
 * The TV is a static poster (the screen, its CRT look and the robot). Play puts the
 * episode's YouTube video on the screen with Figma's CRT shader over it (CrtScreen in
 * overlay mode, the screen's Figma settings: scanlines 59 / 3, shadow mask 9 / 12, static
 * 18, vignette 24, flicker 62, roll 0.93; flat glass, so no masked corners).
 * Controls (Figma "player nav", 504×80): previous · play / pause · next, the progress
 * line (seekable) and a sound button at the end (the video plays with sound; it mutes it).
 * Play is a click, so browsers let it start with sound; if one still refuses (it can when
 * the player took a while to load), it plays muted and the sound button shows that.
 * They play the episodes that have a video, newest first: the hero starts with the
 * newest, an episode page with its own; previous / next load the next one straight into
 * the same screen (no transition), and the next one starts when an episode ends.
 * The YouTube player (privacy-enhanced, youtube-nocookie) loads only on the first play. Its
 * own overlays (title, logo) sit at the frame's edges, so the frame is a little bigger
 * than the screen and they fall outside it; captions are switched off; the screen takes no
 * pointer input — not even on phones — so YouTube's own buttons (the big play / pause in
 * the middle) never show; while the video isn't playing the TV's own dark screen covers
 * it. If a phone doesn't start the video on the first Play (the player was still
 * loading), the next Play starts it straight from the tap.
 * The screen itself is a play / pause button too (over YouTube's frame, so its own buttons
 * still never show): a click starts the episode when nothing plays and pauses it when it
 * does. Its icon in the middle (the bar's play / pause) shows what a click
 * will do — pause on hover while an episode plays, play while one is paused (also on
 * phones, which have no hover). Before the first play there's no icon; a click still starts it.
 * Side windows: the screen mask's two side screens are part of the same picture — the
 * video is laid out across the mask's whole width and masked to Figma's vector screen shape
 * (main screen + two side screens), so they show the real left and right edges of the
 * picture (one player). The poster shows through the same shape (its noise and text), so the
 * screen has that shape before anything plays too; outside it the TV is black.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import CrtScreen from '../../components/ui/CrtScreen.astro';
import hero from '../../assets/radio/tv-hero.png';
import episode from '../../assets/radio/tv-episode.png';
import robot from '../../assets/radio/tv-robot.png';

interface Props {
  variant?: 'hero' | 'episode';
  /** YouTube id of the episode to start with (episode page); the hero starts with the newest */
  start?: string;
}
const { variant = 'hero', start } = Astro.props;
const playlist = (await getCollection('episodes', (e) => !!e.data.youtube))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ id: e.data.youtube!, title: e.data.title }));
const first = Math.max(0, start ? playlist.findIndex((p) => p.id === start) : 0);
const poster = variant === 'hero' ? hero : episode;
const h = variant === 'hero' ? 983 : 872;
// Figma's screen (1522×744) and the robot in front of it (442×405): hero / episode
const screenTop = variant === 'hero' ? 102 : 15;
const robotTop = variant === 'hero' ? 655 : 528;
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
// Player bar: hero (105, 843) · episode (110, 759) — Figma's controls frame + its 5px inset
const bar = variant === 'hero' ? { x: 105, y: 843 } : { x: 110, y: 759 };
// The TV's screen shape: Figma's vector mask (10499:212, 1812×752: the main screen with
// its top and bottom curving in and the two side screens), stretched across the TV's whole width and 10% taller than the
// poster's printed screen (744, less 12 at the top and bottom), centred on it (or lower). Only the
// mask stretches: inside it is the poster's own noise (a patch of it, tiled), and over
// that the poster as it is (a hair wider, ~2%, so its printed edges stay outside), fading
// out just inside its printed screen's top and bottom. The video plays through the same
// shape.
const MASK_W = 1812;
const maskLeft = 0;
const maskW = 1730;
const fitH = 744 - 24;
const maskH = fitH * 1.1;
// centred on the printed screen, then 50 higher, but never closer than 8 to the TV's top
// (so the episode TV's, which has no room above, stays at 8)
const maskTop = Math.max(8, screenTop + 12 - (maskH - fitH) / 2 - 50);
// the poster over the noise: shown from 14 inside its printed screen, faded in over 40
const fadeY = (y: number) => pct(screenTop + y, h);
const fade = `linear-gradient(to bottom, transparent ${fadeY(14)}, #000 ${fadeY(54)}, #000 ${fadeY(744 - 54)}, transparent ${fadeY(744 - 14)})`;
// the noise patch (public/images/radio/tv-noise.jpg, 400×180 of the hero poster's screen)
const noiseSize = `${pct(400, 1730)} auto`;
const at = (x: number) => (x / MASK_W) * maskW; // a mask x on the TV
// stretch the poster so its stretch [from0, from1] lands on the TV's [to0, to1]
const fitX = (from0: number, from1: number, to0: number, to1: number) => {
  const k = (to1 - to0) / (from1 - from0);
  return { k, x0: to0 - from0 * k, style: `left:${pct(to0 - from0 * k, 1730)};width:${pct(1730 * k, 1730)}` };
};
// the printed main screen (113–1615, 8 in) onto the mask's main screen (x 119.7–1692.4 at
// its widest); the robot in front moves with it, so it stays on the poster's own robot
const main = fitX(121, 1607, at(119.7), at(1692.4));
const mainFit = main.style;
const robotX = main.x0 + 678 * main.k;
const robotW = 442 * main.k;
const maskSize = `100% ${pct(maskH, h)}`;
const maskPos = `0 ${pct(maskTop, h - maskH)}`;
// The screen's Figma settings, flat glass (curvature 0) so the video keeps square corners
const crt = { scanlines: 59, scanlineSize: 3, vignette: 24, curvature: 0, jitter: 3 };
---
<section
  class:list={['radio-tv', `radio-tv--${variant}`, 'is-sound']}
  aria-label="Robo Radio player"
  data-tv
  data-playlist={JSON.stringify(playlist)}
  data-index={first}
>
  <!-- The page title: shown on phones (as on Careers); on desktop the TV fills the hero
       and the title is for screen readers only -->
  {variant === 'hero' && <h1 class="radio-tv__heading t-h1 container">Robo Radio</h1>}
  <!-- The TV (poster + screen); on desktop the player bar sits on it, on phones under it -->
  <div class="radio-tv__stage" style={`aspect-ratio: 1730 / ${h}`}>
  <!-- the screen, only through its shape (outside it: the TV's black): the poster's noise
       in all of it, and the poster itself (its text) over the main screen -->
  <div class="radio-tv__glass radio-tv__glass--noise" aria-hidden="true" style={`--mask-size:${maskSize};--mask-pos:${maskPos};--noise-size:${noiseSize}`}></div>
  <div class="radio-tv__glass radio-tv__glass--main" style={`--mask-size:${maskSize};--mask-pos:${maskPos}`}>
    <div class="radio-tv__fit" style={`${mainFit};--fade:${fade}`}>
      <WebGLSlot name="radio-tv" class="radio-tv__scene">
        <Image src={poster} alt="" widths={[1730, 3460]} sizes="100vw" loading={variant === 'hero' ? 'eager' : 'lazy'} />
      </WebGLSlot>
    </div>
  </div>
  <div class="radio-tv__screen" data-screen style={`left:${pct(maskLeft, 1730)};top:${pct(maskTop, h)};width:${pct(maskW, 1730)};height:${pct(maskH, h)}`}>
    <div class="radio-tv__frame" data-frame><div class="radio-tv__video" data-video></div></div>
    <!-- The TV's own dark screen while an episode loads (YouTube's loading screen never
         shows); paused, the screen keeps the frame it stopped on -->
    <div class="radio-tv__standby" aria-hidden="true"></div>
    <CrtScreen overlay settings={crt} />
  </div>
  <!-- The screen as a play / pause button (the bar's play button is the one for keyboards
       and screen readers); the robot in front lets clicks through to it -->
  {playlist.length > 0 && (
    <button type="button" class="radio-tv__toggle" tabindex="-1" aria-hidden="true" data-toggle style={`left:${pct(103, 1730)};top:${pct(screenTop, h)};width:${pct(1522, 1730)};height:${pct(744, h)}`}>
      <span class="radio-tv__toggle-icon">
        <!-- the bar's play / pause icons, at the same size -->
        <svg class="radio-tv__icon-play" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M85.38 41.55 70.4 50.34l-2.74-1.53V31.23l2.63-1.56 15.08 8.72z" /></svg>
        <svg class="radio-tv__icon-pause" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M68.4 31.25h5v17.5h-5zm11 0h5v17.5h-5z" /></svg>
      </span>
    </button>
  )}
  <!-- The robot stands in front of the screen, so the video plays behind it -->
  <Image class="radio-tv__robot" src={robot} alt="" widths={[442, 884]} sizes="26vw" loading={variant === 'hero' ? 'eager' : 'lazy'} style={`left:${pct(robotX, 1730)};top:${pct(robotTop, h)};width:${pct(robotW, 1730)}`} />
  </div>

  {playlist.length > 0 && (
    <div class="radio-tv__bar" style={`left:${(bar.x / 1730) * 100}%;top:${(bar.y / h) * 100}%`} role="group" aria-label="Player">
      <button type="button" class="radio-tv__btn radio-tv__btn--prev" aria-label="Previous episode" data-prev>
        <svg viewBox="0 24 32 32" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="m12.75 40.97 11.53 6.96 1.97-1.13V32.83l-1.89-1.15-11.61 6.9zm-.5-9.42h-5.5v16.5h5.5z" /></svg>
      </button>
      <button type="button" class="radio-tv__btn radio-tv__btn--play" aria-label="Play" data-play>
        <svg class="radio-tv__icon-play" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M85.38 41.55 70.4 50.34l-2.74-1.53V31.23l2.63-1.56 15.08 8.72z" /></svg>
        <svg class="radio-tv__icon-pause" viewBox="46.4 9.8 60 60" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M68.4 31.25h5v17.5h-5zm11 0h5v17.5h-5z" /></svg>
      </button>
      <button type="button" class="radio-tv__btn radio-tv__btn--next" aria-label="Next episode" data-next>
        <svg viewBox="124 24 32 32" fill="none" aria-hidden="true"><path stroke="currentColor" stroke-width="1.5" d="M141.05 40.97l-11.53 6.96-1.97-1.13V32.83l1.89-1.15 11.61 6.9zm.5-9.42h5.5v16.5h-5.5z" /></svg>
      </button>
      <input class="radio-tv__seek" type="range" min="0" max="1000" value="0" step="1" aria-label="Position in the episode" data-seek />
      <button type="button" class="radio-tv__btn radio-tv__btn--sound" aria-label="Mute" aria-pressed="true" data-sound>
        <svg viewBox="2.5 2.5 27 27" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-width="1.27" d="M7 13h4l6-5v16l-6-5H7z" />
          <path class="radio-tv__icon-muted" stroke="currentColor" stroke-width="1.27" d="m20.5 12.5 7 7m0-7-7 7" />
          <path class="radio-tv__icon-sound" stroke="currentColor" stroke-width="1.27" d="M20.5 12.5a5 5 0 0 1 0 7m3-10a9 9 0 0 1 0 13" />
        </svg>
      </button>
      <p class="radio-tv__title visually-hidden" aria-live="polite" data-title></p>
    </div>
  )}
</section>

<script>
  type Item = { id: string; title: string };
  type YTPlayer = {
    playVideo(): void;
    pauseVideo(): void;
    mute(): void;
    unMute(): void;
    loadVideoById(id: string): void;
    getCurrentTime(): number;
    getDuration(): number;
    seekTo(s: number, allowAhead: boolean): void;
    getPlayerState(): number;
    getIframe(): HTMLIFrameElement;
    unloadModule?(name: string): void;
  };
  type YTNamespace = {
    Player: new (el: HTMLElement, opts: Record<string, unknown>) => YTPlayer;
    PlayerState: { ENDED: number; PLAYING: number; PAUSED: number; BUFFERING: number };
  };
  const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };

  // Load YouTube's player API once, on the first play
  let api: Promise<YTNamespace> | null = null;
  const loadApi = () =>
    (api ??= new Promise((resolve) => {
      if (w.YT?.Player) return resolve(w.YT);
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        prev?.();
        resolve(w.YT!);
      };
      const s = document.createElement('script');
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.append(s);
    }));

  for (const root of document.querySelectorAll<HTMLElement>('[data-tv]')) {
    const list: Item[] = JSON.parse(root.dataset.playlist || '[]');
    if (!list.length) continue;
    let index = Number(root.dataset.index) || 0;
    const mount = root.querySelector<HTMLElement>('[data-video]')!;
    const screen = root.querySelector<HTMLElement>('[data-screen]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]')!;
    let player: YTPlayer | null = null;
    let playing = false;
    let sound = true; // plays with sound until the visitor mutes it
    let seeking = false;
    let pendingSeek: number | null = null; // a spot picked on the line before the video had started
    let frame = 0;


    const setPlaying = (on: boolean) => {
      playing = on;
      root.classList.toggle('is-playing', on);
      // paused by the visitor (not just loading): the screen shows its play icon
      root.classList.toggle('is-paused', !on);
      playBtn.setAttribute('aria-label', on ? 'Pause' : 'Play');
      cancelAnimationFrame(frame);
      if (on) frame = requestAnimationFrame(tick);
    };
    // The progress line follows the video while it plays
    const tick = () => {
      if (player && !seeking) {
        const d = player.getDuration();
        seek.value = d ? String(Math.round((player.getCurrentTime() / d) * 1000)) : '0';
        showProgress();
      }
      if (playing) frame = requestAnimationFrame(tick);
    };
    // The played part of the line is solid white
    const showProgress = () => seek.style.setProperty('--p', String(Number(seek.value) / 1000));
    const announce = () => (title.textContent = `Now playing: ${list[index].title}`);

    // The picture: across the TV's width (the side screens show its edges). On a wide
    // screen (desktop) it covers that; on a tall one (phones)
    // the whole 16:9 video shows across the width, centred, the dark screen above and below.
    // Inside that box the YouTube frame is 15% bigger and clipped, so YouTube's title (top)
    // and logo (bottom right) fall outside it
    const box = root.querySelector<HTMLElement>('[data-frame]')!;
    const OVERSCAN = 1.15;
    const fit = () => {
      const frameEl = player?.getIframe();
      if (!frameEl) return;
      const w = screen.offsetWidth;
      const h = screen.offsetHeight;
      const tall = w / h < 1.2;
      const bw = w;
      const bh = tall ? Math.min(h, (w * 9) / 16) : h;
      Object.assign(box.style, { width: `${bw}px`, height: `${bh}px`, left: '0px', top: `${(h - bh) / 2}px` });
      const vw = Math.max(bw, (bh * 16) / 9) * OVERSCAN;
      const vh = (vw * 9) / 16;
      Object.assign(frameEl.style, { width: `${vw}px`, height: `${vh}px`, left: `${(bw - vw) / 2}px`, top: `${(bh - vh) / 2}px` });
    };
    addEventListener('resize', fit);
    const noCaptions = () => {
      player?.unloadModule?.('captions');
      player?.unloadModule?.('cc');
    };

    const start = async () => {
      if (player) return player;
      root.classList.add('is-on');
      const YT = await loadApi();
      return new Promise<YTPlayer>((resolve) => {
        const p = new YT.Player(mount, {
          host: 'https://www.youtube-nocookie.com',
          videoId: list[index].id,
          playerVars: { autoplay: 1, mute: sound ? 0 : 1, controls: 0, rel: 0, playsinline: 1, modestbranding: 1, iv_load_policy: 3, cc_load_policy: 0, disablekb: 1, fs: 0 },
          events: {
            onReady: () => {
              player = p;
              fit();
              if (sound) p.unMute();
              else p.mute();
              p.playVideo();
              announce();
              resolve(p);
              // the browser refused to start it with sound: play muted instead
              setTimeout(() => {
                const state = p.getPlayerState();
                if (sound && state !== YT.PlayerState.PLAYING && state !== YT.PlayerState.BUFFERING) {
                  setSound(false);
                  p.playVideo();
                }
              }, 1500);
            },
            onStateChange: (e: { data: number }) => {
              if (e.data === YT.PlayerState.PLAYING) {
                noCaptions();
                if (pendingSeek !== null && p.getDuration()) {
                  p.seekTo(pendingSeek * p.getDuration(), true);
                  pendingSeek = null;
                }
                setPlaying(true);
              }
              else if (e.data === YT.PlayerState.PAUSED) setPlaying(false);
              else if (e.data === YT.PlayerState.ENDED) go(1);
            },
          },
        });
      });
    };
    // Previous / next: the other episode loads straight into the same screen
    const go = async (step: number) => {
      index = (index + step + list.length) % list.length;
      root.classList.remove('is-paused'); // the next one loads on the dark screen
      seek.value = '0';
      pendingSeek = null;
      showProgress();
      const p = await start();
      p.loadVideoById(list[index].id);
      announce();
    };

    const toggle = () => {
      if (!player) return void start();
      if (playing) player.pauseVideo();
      else player.playVideo();
    };
    playBtn.addEventListener('click', toggle);
    root.querySelector('[data-toggle]')!.addEventListener('click', toggle);
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    function setSound(on: boolean) {
      sound = on;
      root.classList.toggle('is-sound', on);
      soundBtn.setAttribute('aria-pressed', String(on));
      soundBtn.setAttribute('aria-label', on ? 'Mute' : 'Sound on');
      if (on) player?.unMute();
      else player?.mute();
    }
    soundBtn.addEventListener('click', () => setSound(!sound));
    // Dragging along the line moves the picture with it (YouTube's quick, nearby seek, at
    // most ~6 times a second); letting go seeks exactly and plays from there. Before the
    // video has started, the line starts it at the spot picked.
    let lastPreview = 0;
    seek.addEventListener('input', () => {
      seeking = true;
      showProgress();
      const now = performance.now();
      if (player && player.getDuration() && now - lastPreview > 150) {
        lastPreview = now;
        player.seekTo((Number(seek.value) / 1000) * player.getDuration(), false);
      }
    });
    seek.addEventListener('change', async () => {
      seeking = false;
      const at = Number(seek.value) / 1000;
      if (!player) {
        pendingSeek = at;
        return void start();
      }
      player.seekTo(at * player.getDuration(), true);
      if (!playing) player.playVideo();
    });
  }
</script>

<style>
  .radio-tv {
    position: relative;
    background: var(--color-black);
    overflow: hidden;
  }
  .radio-tv__stage {
    position: relative;
    overflow: hidden;
  }
  .radio-tv :global(.radio-tv__scene) {
    position: absolute;
    inset: 0;
  }
  .radio-tv :global(.radio-tv__scene img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The video window (placed inline), masked to Figma's screen shape. Its CRT layer is on
     from the start, over the poster's dark screen and its text; the video, its black and
     the standby screen fade in on the first play */
  .radio-tv__screen {
    position: absolute;
    overflow: hidden;
    pointer-events: none;
  }
  .radio-tv__frame,
  .radio-tv__standby {
    opacity: 0;
    transition: opacity var(--duration-smooth) var(--ease-out);
  }
  .radio-tv.is-on .radio-tv__frame {
    opacity: 1;
    background: var(--color-black);
  }
  /* The video window's shape: Figma's vector mask, stretched to the box (which keeps its
     proportions) */
  .radio-tv__screen {
    -webkit-mask: url(/images/radio/tv-screen-mask.svg) 0 0 / 100% 100% no-repeat;
    mask: url(/images/radio/tv-screen-mask.svg) 0 0 / 100% 100% no-repeat;
  }
  /* The poster through the same shape, so the screen (noise, text) has it from the start */
  .radio-tv__glass {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--mask) var(--mask-pos) / var(--mask-size) no-repeat;
    mask: var(--mask) var(--mask-pos) / var(--mask-size) no-repeat;
  }
  .radio-tv__glass--main {
    --mask: url(/images/radio/tv-screen-mask-main.svg);
  }
  .radio-tv__glass--noise {
    --mask: url(/images/radio/tv-screen-mask.svg);
    background: url(/images/radio/tv-noise.jpg) 0 0 / var(--noise-size) repeat;
  }
  /* the poster, a hair wider (placed inline), fading out at its printed screen's top / bottom */
  .radio-tv__fit {
    position: absolute;
    top: 0;
    height: 100%;
    -webkit-mask: var(--fade);
    mask: var(--fade);
  }
  .radio-tv__fit > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .radio-tv :global(.radio-tv__robot) {
    position: absolute;
    z-index: 2;
    height: auto;
    pointer-events: none;
  }
  /* ── The screen as a button: the bar's icon in the middle, on its own ── */
  .radio-tv__toggle {
    position: absolute;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: 0;
    color: var(--color-white);
    cursor: pointer;
  }
  .radio-tv__toggle-icon {
    display: grid;
    place-items: center;
    opacity: 0;
    scale: 0.9;
    transition:
      opacity var(--duration-normal) var(--ease-out),
      scale var(--duration-normal) var(--ease-out);
  }
  .radio-tv__toggle-icon svg {
    width: max(30px, calc(60 * var(--px)));
    height: max(30px, calc(60 * var(--px)));
  }
  /* what a click does: play while an episode is paused; pause on hover while it plays.
     Nothing before the first play */
  .radio-tv.is-paused .radio-tv__toggle-icon {
    opacity: 1;
    scale: 1;
  }
  @media (hover: hover) {
    .radio-tv.is-playing .radio-tv__toggle:hover .radio-tv__toggle-icon {
      opacity: 1;
      scale: 1;
    }
  }
  .radio-tv__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .radio-tv__standby {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.45) 0 1px, transparent 1px 3px),
      #121212;
    transition: opacity var(--duration-normal) var(--ease-out);
  }
  /* only while an episode loads: paused, the screen keeps the frame it stopped on */
  .radio-tv.is-on:not(.is-playing, .is-paused) .radio-tv__standby {
    opacity: 1;
  }
  .radio-tv__video,
  .radio-tv__screen :global(iframe) {
