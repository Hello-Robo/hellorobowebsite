---
/**
 * Robo Radio — Intro
 * Figma: "2 intro" (10105:306), 1730×1098
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-306
 */
---
<section class="radio-intro">
  <img src="/images/radio/stamp-radio-intro.svg" alt="" width="320" style="--w: 320" height="165" />
  <!-- Figma's line breaks, hidden in CSS (the box is narrower now) -->
  <p class="radio-intro__text t-h3">
    We design the human side of robotics. <br />
    Robo Radio is where that belief becomes <br />
    a conversation — through intimate <br />
    conversations with the people shaping the field. <br />
    Hosted by Shakir Dzheyranov. Produced <br />
    by Hello Robo.
  </p>
</section>

<style>
  .radio-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(14 * var(--px));
    padding-top: calc(211 * var(--px));
    padding-bottom: calc(360 * var(--px));
    text-align: center;
    background: var(--color-white);
    color: var(--color-black);
  }
  /* a step under H3 (50): 44 at 1728, in a box 10% narrower than the scaled Figma one (890) */
  .radio-intro__text {
    font-size: max(26px, calc(44 * var(--px)));
    width: calc(801 * var(--px));
    text-wrap: pretty; /* no single word left on the last line */
    max-width: 100%;
  }
  /* Figma's fixed line breaks don't fit the narrower box: the text wraps on its own */
  .radio-intro__text br {
    display: none;
  }

  /* ── Mobile: Home intro rhythm; Figma's desktop line breaks are dropped ── */
  @media (max-width: 1023px) {
    .radio-intro {
      gap: var(--space-24);
      padding: 96px 32px 164px;
    }
    .radio-intro img {
      width: 193px;
      height: auto;
    }
    .radio-intro__text {
      font-size: var(--type-h3-size-mobile);
    }
  }
</style>
