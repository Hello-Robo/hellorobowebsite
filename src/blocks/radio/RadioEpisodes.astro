---
/**
 * Robo Radio — All episodes
 * Figma: "all episodes" (10105:985), 1730×2694, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10105-985
 * Rows from the episodes collection (listed: true), newest first. As in Figma (e.g. the
 * Sanketh Yayathi / Alvin Groen rows, 10105:1633) the row title is the guest's name — one
 * line at H2 — and the line under it is what they do; the CMS title ("Robo Radio 14: …")
 * is used on the episode page. The first INITIAL rows
 * show; "Load more" reveals STEP more per click and disappears when all are shown.
 * Without JavaScript every row shows and the button stays hidden.
 * An episode page uses the same block under its player for the one episode after it
 * (`next`): labelled "Next episode", one row, no Load more, on white.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../../components/ui/Button.astro';

interface Props {
  /** Episode page: show only the episode after this one (by id), as "Next episode" */
  after?: string;
}
const { after } = Astro.props;
const all = (await getCollection('episodes', (e) => e.data.listed)).sort((a, b) => a.data.order - b.data.order);
// the next one in the list (as the player's "next" goes), back to the first after the last
const at = after ? all.findIndex((e) => e.id === after) : -1;
const next = after ? all[(at + 1) % all.length] : undefined;
const episodes = after ? (next && next.id !== after ? [next] : []) : all;
const INITIAL = 6;
const STEP = 2;
---
{episodes.length > 0 && (
<section class:list={['radio-episodes', after ? 'theme-light' : 'theme-dark', { 'radio-episodes--next': after }]}>
  <div class="container">
    <p class="t-body">{after ? 'Next episode' : 'All episodes'}</p>
    <ul class="radio-episodes__list" id="radio-episode-list" data-episodes data-initial={INITIAL} data-step={STEP}>
      {episodes.map((e) => (
        <li class="radio-episodes__row">
          <div class="radio-episodes__text">
            <h3 class="t-h2">{e.data.guest}</h3>
            <p class="radio-episodes__line t-body">{e.data.guestTitle}</p>
            <Button href={`/robo-radio/${e.id}`} variant={after ? 'dark' : 'light'} icon="arrow">Watch</Button>
          </div>
          {/* the cover links to the episode too (Watch is the one for keyboards / screen readers) */}
          <a class="radio-episodes__cover" href={`/robo-radio/${e.id}`} tabindex="-1" aria-hidden="true">
            {e.data.cover && <Image src={e.data.cover} alt="" widths={[340, 680]} sizes="(min-width: 1728px) 340px, (min-width: 1024px) 20vw, 100vw" loading="lazy" />}
          </a>
        </li>
      ))}
    </ul>
    {episodes.length > INITIAL && (
      <div class="radio-episodes__more" hidden data-load-more>
        <Button variant="light" icon="hex" aria-controls="radio-episode-list">Load more</Button>
      </div>
    )}
  </div>
</section>
)}

<script>
  // Load more: hide rows past the first INITIAL, reveal STEP per click
  for (const list of document.querySelectorAll<HTMLElement>('[data-episodes]')) {
    const more = list.parentElement?.querySelector<HTMLElement>('[data-load-more]');
    const button = more?.querySelector('button');
    const rows = [...list.children] as HTMLElement[];
    const step = Number(list.dataset.step) || 2;
    let shown = Number(list.dataset.initial) || rows.length;
    if (!more || !button || rows.length <= shown) continue;
    const render = () => {
      rows.forEach((row, i) => (row.hidden = i >= shown));
      more.hidden = shown >= rows.length;
    };
    button.addEventListener('click', () => {
      const first = shown;
      shown = Math.min(rows.length, shown + step);
      render();
      // move focus to the first new episode so keyboard users land on it
      rows[first]?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
    });
    render();
  }
</script>

<style>
  .radio-episodes {
    padding-top: calc(180 * var(--px));
  }
  /* Episode page, under the player: room above and below the one row */
  .radio-episodes--next {
    padding-top: calc(120 * var(--px));
    padding-bottom: calc(120 * var(--px));
  }
  .radio-episodes--next .radio-episodes__row {
    border-top-color: var(--line-on-light);
  }
  .radio-episodes__list {
    margin-top: var(--space-40);
  }
  /* Rule above each row, calc(40 * var(--px)) around it; no rule after the last row */
  .radio-episodes__row {
    display: grid;
    grid-template-columns: calc(680 * var(--px)) 1fr calc(680 * var(--px));
    padding-top: var(--space-40);
    padding-bottom: var(--space-40);
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  .radio-episodes__row:last-child {
    padding-bottom: 0;
  }
  .radio-episodes__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  /* Figma: title, 20, line (457 wide); the Watch button sits on the row's bottom edge
     (178 below the text in Figma) and never closer than 40 if the text runs long */
  .radio-episodes__line {
    width: calc(457 * var(--px));
    max-width: 100%;
    margin-top: var(--space-20);
    margin-bottom: var(--space-40);
  }
  .radio-episodes__text :global(.button) {
    margin-top: auto;
  }
  /* The vertical poster (1082×1530), 340 wide, at the right of the row */
  .radio-episodes__cover {
    display: block;
    grid-column: 3;
    justify-self: end;
    width: calc(340 * var(--px));
    aspect-ratio: 1082 / 1530;
    background: var(--color-ink);
    overflow: hidden;
  }
  .radio-episodes__cover :global(img) {
    transition: scale var(--duration-smooth) var(--ease-out);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* hover: the cover zooms in 5% inside its frame (mouse only) */
  @media (hover: hover) {
    .radio-episodes__cover:hover :global(img) {
      scale: 1.05;
    }
  }
  .radio-episodes__more {
    display: flex;
    justify-content: center;
    margin-top: calc(120 * var(--px));
  }

  /* ── Mobile: cover on top of each row, then title, line and button ── */
  @media (max-width: 1023px) {
    .radio-episodes {
      padding-top: 0;
    }
    .radio-episodes--next {
      padding-top: var(--space-24);
      padding-bottom: 48px;
    }
    .radio-episodes__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-24);
      /* 48 above and below the rule between episodes */
      padding-block: 48px;
    }
    /* no rule straight under the invite block */
    .radio-episodes__row:first-child {
      border-top: 0;
      padding-top: var(--space-24);
    }
    .radio-episodes__cover {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
      order: -1;
    }
    .radio-episodes__line {
      margin-top: var(--space-12);
    }
    .radio-episodes__text :global(.button) {
      align-self: stretch;
      margin-top: var(--space-24);
    }
    /* Load more 32 under the last Watch (the row's own 48 bottom is taken back) */
    .radio-episodes__more {
      margin-top: -16px;
    }
    .radio-episodes__more :global(.button) {
      flex: 1;
    }
  }
  /* Rows / button hidden by Load more (their display rules would otherwise win over [hidden]) */
  .radio-episodes__row[hidden],
  .radio-episodes__more[hidden] {
    display: none;
  }
</style>
