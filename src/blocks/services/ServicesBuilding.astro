---
/**
 * Services — Building toward yes
 * Figma: "Frame 2147232853" (10103:1223), 1728×1035, black
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10103-1223
 * The logos come from the CMS ("Services page"): a row of six 264×355 tiles, 12 apart, each
 * logo centred in its tile at its width (px at 1728). Client logos show white; a
 * micrographic keeps its own colours (and may run past its tile, as the stamps do in Figma).
 * Phones: the tiles in two columns.
 */
import { getEntry } from 'astro:content';

const page = await getEntry('services-page', 'services-page');
const tiles = page?.data.clients ?? [];
const clients = tiles.filter((t) => !t.micrographic).map((t) => t.name);
---
<section class="services-building theme-dark">
  <div class="services-building__head container">
    <h2 class="services-building__title t-h1">Building toward yes</h2>
    <p class="services-building__text t-body">
      We work with teams building new ways to move, work and live — from robotics and autonomy to the technology around them. Together, we turn complex ideas into brands, products and stories people can understand, trust and say yes to.
    </p>
  </div>
  <ul class="services-building__logos container" aria-label={clients.join(', ')}>
    {tiles.map((t) => (
      <li class:list={['services-building__tile', { 'is-micro': t.micrographic }]} style={`--w: ${t.width || 140}`} aria-hidden="true">
        <img src={t.logo} alt="" loading="lazy" decoding="async" />
      </li>
    ))}
  </ul>
</section>

<style>
  .services-building {
    padding-top: var(--space-80);
    padding-bottom: var(--space-80);
  }
  .services-building__head {
    display: grid;
    grid-template-columns: calc(968 / 1648 * 100%) calc(676 * var(--px));
    align-items: start;
  }
  .services-building__title {
    width: calc(766 * var(--px));
    max-width: 100%;
  }
  .services-building__text {
    margin-top: calc(16 * var(--px));
  }
  .services-building__logos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: calc(12 * var(--px));
    margin-top: calc(292 * var(--px));
  }
  .services-building__tile {
    position: relative;
    aspect-ratio: 264 / 355;
  }
  /* centred at its width (px of the 264-wide tile at 1728); may run past the tile */
  .services-building__tile img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--w) / 264 * 100%);
    max-width: none;
    height: auto;
    translate: -50% -50%;
  }
  /* client logos are uploaded black: white on the black block */
  .services-building__tile:not(.is-micro) img {
    filter: brightness(0) invert(1);
  }

  /* ── Mobile: stacked head, straight after the block above (no white gap); the logo
     tiles in two columns ── */
  @media (max-width: 1023px) {
    .services-building {
      padding-top: 164px;
      padding-bottom: 64px;
    }
    .services-building__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .services-building__text {
      margin-top: var(--space-24);
    }
    .services-building__logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 64px;
    }
  }
</style>
