---
/**
 * Services — Device visual (full width, marked "video" in Figma)
 * Figma: "Frame 2147232849" (10103:211), 1728×945
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10103-211
 * Plays the home page's showreel (the General reel from the S3 bucket, as in HomeShowreel):
 * muted, looping, only while it can be seen. Phones get its -mobile.mp4.
 */
import VideoSlot from '../../components/ui/VideoSlot.astro';
import { showreel } from '../../data/showreel';

const { src, mobileSrc, webm, poster } = showreel;
---
<section class="services-device" aria-label="Showreel">
  {/* Mobile: a vertical 4:5 crop */}
  <VideoSlot ratio="1728 / 945" mobileRatio="4 / 5" src={src} mobileSrc={mobileSrc} webm={webm} poster={poster} autoplay />
</section>

<style>
  .services-device {
    background: var(--color-black);
  }
</style>
