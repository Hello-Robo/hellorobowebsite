---
/**
 * Work — Project wheel (Home "Featured work" and the Work page)
 * Figma: Home "Portfolio page d" (10093:1049) / Work "Portfolio page" (10100:11973), 1728×1117
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-1049
 *
 * Desktop: the project names are printed on a real 3D drum (CSS perspective +
 * rotateX/translateZ): each name is a face of a cylinder, so names away from the front
 * are foreshortened, keystoned and pulled toward the vanishing point like letters on a
 * turning drum. The block pins to the screen and scrolling turns the drum through every
 * project once; the name at the front is the active project: its background and
 * services show, and clicking its name opens the project. Row spacing ≈ Figma's (≈ 110px);
 * the front name is at full opacity and the others fade fast (FADE), for contrast.
 * The drum follows its input with time-based easing (SMOOTH) and magnetic detents (each
 * project sticks at the front, then the drum moves fast to the next and snaps into place);
 * one project = 70% of a screen of scrolling. A 70% black layer sits over the backgrounds.
 * Figma's CRT screen shader (CrtScreen overlay, as on the Robo Radio player) sits on top,
 * with the Work frame's values. Home and the Work page behave the same, except:
 * `framed` (Home): starts as Figma's 1648×1117 window inside the page margins, the page
 * around it; when it pins, the first half screen of scrolling opens it to the full screen
 * as the Home showreel does (a clip around it widens, nothing is resized), then the wheel
 * turns with the page.
 * `infinite` (Work page): full screen, and the wheel takes the scroll input itself.
 * Services and the project's mark change as on the Services page: the lines slide out of
 * their masks one after another and the mark slides through its own a beat later, in the
 * direction the wheel turns (the outgoing ones leave the way it's going). Hovering a name lights it up.
 * Phones (Home and the Work page): this block is desktop only; the pages add WorkWheelMobile,
 * a flat, lighter wheel (Home: `featured`, the same projects as here).
 * Projects come from the projects collection (CMS), in `order`; the first is in front. Home
 * shows only the ones ticked "Featured" in the CMS Home page section; the Work page all.
 */
import { getCollection } from 'astro:content';
import Media from '../../components/ui/Media.astro';
import CrtScreen from '../../components/ui/CrtScreen.astro';

interface Props {
  as?: 'section' | 'div';
  /** Inside the page margins (Home) instead of full screen (Work) */
  framed?: boolean;
  /** Work page: the wheel takes the scroll input itself and turns endlessly (no page scroll) */
  infinite?: boolean;
}
const { as: Tag = 'section', framed = false, infinite = false } = Astro.props;

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// Home: the projects ticked "Featured" in the CMS (Home page), still in the Projects order
const featured = (await getCollection('home'))[0]?.data.featured ?? [];
const projects = framed && featured.length ? all.filter((p) => featured.includes(p.id)) : all;
const active = projects[0];

// 3D drum: the names go all the way round a cylinder. The number of faces is a whole
// number of project loops (≈ 40), so the drum closes seamlessly; STEP is the angle
// between names and the radius keeps Figma's ≈ 110px spacing between the front rows,
// so the drum runs past the top and bottom of the frame as in Figma.
const ROW = 110; // 1117-frame units between the front rows
const LOOPS = projects.length ? Math.max(1, Math.round(40 / projects.length)) : 0;
const FACES = projects.length * LOOPS;
const STEP = FACES ? 360 / FACES : 0;
const RADIUS = FACES ? Math.round(ROW / Math.sin((STEP * Math.PI) / 180)) : 0;
// Opacity by distance from the front, in rows: the front project stands out clearly,
// the rest fall away fast (more contrast than Figma's 1 / 0.5 / 0.35 …, as requested)
const FADE = [1, 0.25, 0.14, 0.08, 0.05, 0.03, 0.02, 0];
const fadeAt = (d: number) => FADE[Math.min(Math.round(Math.abs(d)), FADE.length - 1)];
const faces = Array.from({ length: FACES }, (_, i) => {
  const d = Math.min(i, FACES - i); // rows from the front at rest
  return { i, project: projects[i % projects.length], opacity: fadeAt(d) };
});
// The mark at the left of the front name: each project's first (round) micrographic from
// the CMS, the globe when it has none; it changes with the active project
const markOf = (p: (typeof projects)[number]) => p.data.micrographics.left ?? '/images/home/work-globe.svg';
const wheelData = JSON.stringify({ step: STEP, fade: FADE, faces: FACES, items: projects.map((p) => ({ name: p.data.name, href: `/work/${p.id}`, nda: p.data.nda })) });
// CRT shader settings that differ from CrtScreen's defaults (Figma 10100:11974)
const crt = { flicker: 22, noise: 8, rollSpeed: 0.35 };
---
{active && (
<Tag class:list={['project-wheel', 'theme-dark', 'only-desktop', { 'project-wheel--framed': framed, 'project-wheel--infinite': infinite }]} aria-label="Selected work" style={`--count: ${projects.length}`} data-wheel={wheelData} data-infinite={infinite ? '' : undefined}>
  <div class="project-wheel__stage" data-active="0">
    <div class="project-wheel__frame">
      <div class="project-wheel__canvas">
        <div class="project-wheel__bgs">
          {projects.map((p, i) => (
            <div class:list={['project-wheel__bg', { 'is-current': i === 0 }]} data-index={i}>
              <Media class="project-wheel__bg-media" media={p.data.reveal} widths={[1400, 2406]} sizes="100vw" loading="lazy" />
            </div>
          ))}
        </div>
        <div class="project-wheel__shade" aria-hidden="true"></div>

        <hr class="project-wheel__rule" />
        {projects.map((p, i) => (
          <span class:list={['project-wheel__mark', { 'is-current': i === 0 }]} data-index={i} data-state={i === 0 ? 'current' : 'next'}>
            <img src={markOf(p)} alt="" height="79" loading="lazy" />
          </span>
        ))}

        <div class="project-wheel__names" aria-hidden="true" style={`--radius: ${RADIUS}`}>
          <ol class="project-wheel__drum">
            {faces.map((f) => (
              <li
                class:list={['project-wheel__name', 't-h2', { 'is-front': f.i === 0 }]}
                style={`--a: ${-f.i * STEP}deg; opacity: ${f.opacity}`}
              >
                {f.project.data.nda ? (
                  /* under NDA: the NDA tag after the name (Figma 10266:1554), no link, no VIEW */
                  <span>{f.project.data.name}<img class="project-wheel__nda" src="/images/project/nda.svg" alt="" width="46" height="32" /></span>
                ) : (
                  <a href={`/work/${f.project.id}`} tabindex={f.i === 0 ? undefined : -1}>{f.project.data.name}</a>
                )}
              </li>
            ))}
          </ol>
        </div>

        {/* no VIEW button: the name in front opens the project */}

        {projects.map((p, i) => (
          <ul class:list={['project-wheel__services', 't-body', { 'is-current': i === 0 }]} data-index={i} data-state={i === 0 ? 'current' : 'next'}>
            {p.data.services.map((s, si) => <li><span class="mask"><span style={`--d: ${si + 1}`}>{s}</span></span></li>)}
          </ul>
        ))}

        <CrtScreen overlay settings={crt} />
      </div>
    </div>
  </div>
  <!-- The wheel is decorative motion; this is the same list for keyboard and screen readers -->
  <ul class="visually-hidden">
    {projects.map((p) => <li>{p.data.nda ? `${p.data.name} (under NDA)` : <a href={`/work/${p.id}`}>{p.data.name}</a>}</li>)}
  </ul>
</Tag>
)}

<script>
  import { slideScrub } from '../../scripts/slide-scrub';
  import { sfx } from '../../scripts/sound';
  import { blinkLogo } from '../../scripts/robo-logo';
  import { reducedMotion } from '../../scripts/media-query';

  // NDA projects don't open: a click on one blinks its NDA tag instead — 100% → 30% → 100%,
  // 4 times in 1s — with the contact form's "nope" sound. Covers the desktop wheel, the phone
  // wheel (WorkWheelMobile).
  document.addEventListener('click', (e) => {
    const name = (e.target as HTMLElement).closest('.project-wheel__name, .work-wheel__row');
    const tag = name?.querySelector<HTMLElement>('.project-wheel__nda, .work-wheel__nda');
    // a name away from the front only turns the wheel (below)
    if (!tag || name!.matches('.project-wheel__name:not(.is-front), .work-wheel__row[aria-hidden="true"]')) return;
    tag.getAnimations().forEach((a) => a.cancel());
    tag.animate([{ opacity: 1 }, { opacity: 0.3 }, { opacity: 1 }], { duration: 250, iterations: 4, easing: 'ease-in-out' });
    sfx('error');
    blinkLogo();
  });

  // Turns page scroll into the drum's rotation: one pass through every project while
  // the block is pinned. offset 0 = first project in front, offset N = back to it.
  type Wheel = { step: number; fade: number[]; faces: number; items: { name: string; href: string }[] };

  for (const root of document.querySelectorAll<HTMLElement>('[data-wheel]')) {
    const data: Wheel = JSON.parse(root.dataset.wheel || '{}');
    const N = data.items.length;
    const stage = root.querySelector<HTMLElement>('.project-wheel__stage');
    const drum = root.querySelector<HTMLElement>('.project-wheel__drum');
    const rows = [...root.querySelectorAll<HTMLElement>('.project-wheel__name')];
    // the backgrounds uncover one another as the drum turns, round and round (slide-scrub.ts)
    const pictures = slideScrub([...root.querySelectorAll<HTMLElement>('.project-wheel__bg')], {
      frame: root.querySelector<HTMLElement>('.project-wheel__bgs'),
      wrap: true,
      smooth: false,
    });
    const lists = [...root.querySelectorAll<HTMLElement>('.project-wheel__services, .project-wheel__mark')];
    if (!stage || !drum || !N) continue;
    const F = data.faces;
    const last = data.fade.length - 1;
    const mod = (n: number, m: number) => ((n % m) + m) % m;
    // Opacity for a face `a` rows from the front, eased between Figma's steps
    const fade = (a: number) => {
      if (a >= last) return 0;
      const i = Math.floor(a);
      return data.fade[i] + (data.fade[i + 1] - data.fade[i]) * (a - i);
    };
    let current = 0;
    let frame = 0;

    // Smooth follow: the drum eases toward `target`, time-based so it feels the same at
    // any frame rate. SMOOTH = seconds to cover ~63% of the remaining turn.
    const reduceMotion = reducedMotion;
    const SMOOTH = reduceMotion ? 0.001 : 0.16;
    // Magnetic detents: the drum sticks a little to the project at the front, then moves
    // quickly to the next one, as if each name were pulled into place.
    // magnet(x) keeps every whole project where it is and is steepest halfway between
    // two projects (MAGNET 0 = no pull, toward 1 = stickier).
    const MAGNET = reduceMotion ? 0 : 0.65;
    const magnet = (x: number) => x - (MAGNET * Math.sin(2 * Math.PI * x)) / (2 * Math.PI);
    let offset = 0;
    let target = 0;
    let running = 0;
    let lastT = 0;

    // Hover: the name under the cursor lights up (the names next to it a touch). `fades` is
    // each name's opacity on the drum, `lit` the eased hover on top of it.
    const HOVER_LIGHT = 0.6; // share of the way to full white a hovered name goes
    const fades = rows.map(() => 0);
    const lit = rows.map(() => 0);
    const paint = (i: number) => {
      rows[i].style.opacity = String(fades[i] + lit[i] * (1 - fades[i]) * HOVER_LIGHT);
    };

    const place = (offset: number) => {
      drum.style.setProperty('--rot', `${offset * data.step}deg`);
      const base = Math.round(offset);
      const frontFace = mod(base, F);
      rows.forEach((row, i) => {
        // rows between this face and the front, the short way round the drum
        let d = mod(i - offset, F);
        if (d > F / 2) d -= F;
        const o = fade(Math.abs(d));
        fades[i] = o;
        paint(i);
        row.classList.toggle('is-shown', o > 0.04);
        const front = i === frontFace;
        row.classList.toggle('is-front', front);
        const link = row.firstElementChild as HTMLElement;
        if (link.tagName === 'A') link.tabIndex = front ? 0 : -1;
      });
      pictures.set(offset);
      const next = mod(base, N);
      if (next !== current) {
        // which way the drum turned (the short way round), so the outgoing services leave
        // the way they came and the incoming ones arrive from the other side
        let dir = mod(next - current, N);
        if (dir > N / 2) dir -= N;
        const forward = dir >= 0;
        const prev = current;
        current = next;
        stage.dataset.active = String(next);
        lists.forEach((el) => {
          const i = Number(el.dataset.index);
          el.classList.toggle('is-current', i === next);
          if (i === next) {
            // start from the side it comes in from, then slide in
            const from = forward ? 'next' : 'past';
            if (el.dataset.state !== from) {
              el.dataset.state = from;
              el.classList.add('is-instant');
              void el.offsetWidth;
              el.classList.remove('is-instant');
            }
            el.dataset.state = 'current';
          } else if (i === prev) el.dataset.state = forward ? 'past' : 'next';
        });
      }
    };

    // hover: how lit each name should be, eased toward it every frame
    const litTo = rows.map(() => 0);
    let hoverFrame = 0;
    const hoverTick = () => {
      hoverFrame = 0;
      let moving = false;
      rows.forEach((row, i) => {
        const l = lit[i] + (litTo[i] - lit[i]) * 0.14;
        const settled = Math.abs(l - litTo[i]) < 0.002;
        lit[i] = settled ? litTo[i] : l;
        if (!settled) moving = true;
        if (lit[i] || !settled) paint(i);
      });
      if (moving) hoverFrame = requestAnimationFrame(hoverTick);
    };
    const hoverRun = () => {
      if (!hoverFrame) hoverFrame = requestAnimationFrame(hoverTick);
    };
    if (!reduceMotion && matchMedia('(hover: hover)').matches) {
      stage.addEventListener('pointermove', (e) => {
        rows.forEach((row, i) => {
          litTo[i] = 0;
          if (fades[i] <= 0.04) return;
          const r = row.getBoundingClientRect();
          // 1 on the name, falling to 0 a row away
          const near = Math.max(0, 1 - Math.abs(e.clientY - (r.top + r.height / 2)) / r.height);
          const over = e.clientX >= r.left - 40 && e.clientX <= r.right + 40;
          if (!near || !over) return;
          litTo[i] = near;
        });
        hoverRun();
      });
      stage.addEventListener('pointerleave', () => {
        litTo.fill(0);
        hoverRun();
      });
    }

    // ── Work page: endless wheel ─────────────────────────────────
    // Wheel / trackpad / touch / keys turn the drum directly; the offset never stops,
    // so it loops forever both ways. It eases toward the target and, once input stops,
    // settles the nearest project at the front.
    const tick = (t: number) => {
      const dt = lastT ? Math.min(0.05, (t - lastT) / 1000) : 1 / 60;
      lastT = t;
      offset += (target - offset) * (1 - Math.exp(-dt / SMOOTH));
      if (Math.abs(target - offset) < 0.0005) offset = target;
      place(magnet(offset));
      if (offset === target) {
        running = 0;
        lastT = 0;
      } else running = requestAnimationFrame(tick);
    };
    const follow = () => {
      if (!running) running = requestAnimationFrame(tick);
    };

    // A click on a name away from the front turns it to the front (the short way round)
    // instead of opening it. Work page: the drum turns. Home: the page scrolls to where that
    // project is at the front, and the drum turns with it.
    let turnTo = (to: number) => {
      target = to;
      follow();
    };
    root.querySelector('.project-wheel__names')?.addEventListener('click', (e) => {
      const row = (e.target as HTMLElement).closest<HTMLElement>('.project-wheel__name');
      if (!row || row.classList.contains('is-front')) return;
      e.preventDefault();
      let d = mod(rows.indexOf(row) - Math.round(target), F);
      if (d > F / 2) d -= F;
      turnTo(Math.round(target) + d);
    });

    if (root.hasAttribute('data-infinite')) {
      let idle = 0;
      const perProject = () => window.innerHeight * 0.7;
      const nudge = (projects: number) => {
        target += projects;
        window.clearTimeout(idle);
        // once input stops, snap the nearest project to the front
        idle = window.setTimeout(() => {
          target = Math.round(target);
          follow();
        }, 120);
        follow();
      };
      root.addEventListener(
        'wheel',
        (e) => {
          e.preventDefault();
          const px = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * window.innerHeight : e.deltaY;
          nudge(px / perProject());
        },
        { passive: false },
      );
      let touchY: number | null = null;
      root.addEventListener('touchstart', (e) => (touchY = e.touches[0].clientY), { passive: true });
      root.addEventListener(
        'touchmove',
        (e) => {
          if (touchY === null) return;
          e.preventDefault();
          const y = e.touches[0].clientY;
          nudge((touchY - y) / perProject());
          touchY = y;
        },
        { passive: false },
      );
      root.addEventListener('touchend', () => (touchY = null));
      window.addEventListener('keydown', (e) => {
        if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
        if (document.documentElement.dataset.menu === 'open') return;
        const step = { ArrowDown: 1, ArrowUp: -1, PageDown: 1, PageUp: -1, ' ': e.shiftKey ? -1 : 1 }[e.key];
        if (step === undefined) return;
        e.preventDefault();
        target = Math.round(target) + step;
        follow();
      });
      stage.style.setProperty('--enter', '1');
      place(0);
    } else {
      // ── Home: the wheel turns with the page scroll while the block is pinned ──
      // Framed (Home): the first part of the scroll widens the block to full screen
      const expandOf = () => stage.offsetHeight * (Number(getComputedStyle(root).getPropertyValue('--expand')) || 0);
      // the drum runs 0 → N (N is project 0 again) over the scroll after the widening
      turnTo = (to: number) => {
        if (to < 0 || to > N) to = mod(to, N);
        const rect = root.getBoundingClientRect();
        const expand = expandOf();
        const travel = rect.height - stage.offsetHeight - expand;
        window.scrollTo({ top: window.scrollY + rect.top + expand + (to / N) * travel, behavior: reduceMotion ? 'auto' : 'smooth' });
      };
      const update = () => {
        frame = 0;
        // phones hide this wheel (.only-desktop; they get WorkWheelMobile): nothing to turn
        if (!root.offsetWidth) return;
        const rect = root.getBoundingClientRect();
        const travel = rect.height - stage.offsetHeight;
        const expand = expandOf();
        const clamp = (v: number) => Math.min(1, Math.max(0, v));
        stage.style.setProperty('--enter', String(expand > 0 ? clamp(-rect.top / expand) : 1));
        const progress = travel - expand > 0 ? clamp((-rect.top - expand) / (travel - expand)) : 0;
        target = progress * N;
        follow();
      };
      const request = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request);
      update();
      // start where the page already is (e.g. after a reload mid-page), without easing in
      offset = target;
      place(offset);
    }
  }
</script>

<style>
  /* One screen to show the block + one screen per project while the wheel turns (Home) */
  /* Work page: one screen, the wheel turns in place (no page scroll) */
  .project-wheel--infinite {
    height: 100vh !important;
    overscroll-behavior: none;
    touch-action: none;
  }
  .project-wheel {
    position: relative;
    --expand: 0;
    --per-project: 0.7; /* screens of scrolling per project (Home) */
    height: calc(100vh + (var(--expand) + var(--count) * var(--per-project)) * 100vh);
  }
  .project-wheel__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  /* Home: inside the page margins (Figma 1648×1117 window onto the 1728 frame) */
  .project-wheel__frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-black);
  }
  /* Framed: opens like the Home showreel — the wheel fills the screen underneath and a clip
     around it widens from the Figma window (page margins at the sides, 1648×1117 in shape,
     centred) to the full screen as --enter goes 0 → 1. The page shows around it (no black
     section behind) */
  .project-wheel--framed {
    --expand: 0.5;
    background: none;
  }
  .project-wheel--framed .project-wheel__frame {
    /* eased, as the showreel */
    --e: calc(1 - (1 - var(--enter, 0)) * (1 - var(--enter, 0)) * (1 - var(--enter, 0)));
    --ix: var(--page-margin);
    --iy: max(0px, calc((100vh - (100vw - 2 * var(--page-margin)) * 1117 / 1648) / 2));
    clip-path: inset(calc((1 - var(--e)) * var(--iy)) calc((1 - var(--e)) * var(--ix)));
  }
  /* Everything inside is placed in the 1728×1117 Figma frame (% of this box) */
  .project-wheel__canvas {
    position: absolute;
    inset: 0;
  }

  /* Backgrounds: fill the frame, sliding in per project; in a layer of their own, so the
     sliding pictures stay under the names. Not oversized: slide-scrub.ts already zooms the
     picture 1.1–1.13× for its drift, which is all the slack it needs */
  .project-wheel__bgs {
    position: absolute;
    inset: 0;
    isolation: isolate;
  }
  .project-wheel__bg {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  /* without JS the first shows; with it, slide-scrub.ts shows the ones in play */
  .project-wheel__bg.is-current {
    visibility: visible;
  }
  /* a darker layer over the backgrounds (60%) */
  .project-wheel__shade {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.6);
  }
  .project-wheel :global(.project-wheel__bg-media) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .project-wheel__rule {
    position: absolute;
    left: calc(40 / 1728 * 100%);
    right: calc(40 / 1728 * 100%);
    top: calc(622 / 1117 * 100%);
    margin: 0;
    border: 0;
    border-top: var(--line-width) solid var(--line-on-dark);
  }
  /* Globe mark on the same line as the front name: centred on the drum's front row
     (549 / 1117), nudged down to the middle of the capitals (0.07em below the line box's
     middle), at any window shape */
  /* every project's mark is the same height (the globe's 79 in the 1117 frame), any width */
  .project-wheel__mark {
    position: absolute;
    left: calc(40 / 1728 * 100%); /* the rule's left end */
    top: calc(549 / 1117 * 100%);
    height: calc(79 / 1117 * 100%);
    translate: 0 calc(-50% + 0.07 * var(--type-h2-size));
    /* the mask: the mark slides through it, like the services' lines */
    overflow: hidden;
  }
  .project-wheel__mark img {
    display: block;
    width: auto;
    height: 100%;
    max-width: none;
    filter: brightness(0) invert(1); /* every mark white on the wheel */
    transform: translateY(var(--y, 0));
    transition: transform var(--duration-smooth) var(--ease-out);
  }
  .project-wheel__mark[data-state='next'] img {
    --y: 110%;
  }
  .project-wheel__mark[data-state='past'] img {
    --y: -110%;
  }
  /* incoming: a beat after the services, as the Services stamp */
  .project-wheel__mark[data-state='current'] img {
    transition-delay: 0.3s;
  }
  .project-wheel__mark.is-instant img {
    transition: none;
  }

  /* ── The 3D drum ──────────────────────────────────────────────
     The names box is the camera: perspective from the middle of the frame, so faces
     away from the front shrink and drift toward the centre (Figma's indent). The drum
     axis sits at the front row's left edge / centre line (319, 549); it is pushed back
     by R so the front face is at its real size. Lengths are in screen-height units
     because the stage is 100vh tall (1117 in Figma). */
  .project-wheel__names {
    position: absolute;
    inset: 0;
    --unit: calc(100vh / 1117);
    perspective: calc(1300 * var(--unit));
    perspective-origin: calc(864 / 1728 * 100%) calc(549 / 1117 * 100%);
  }
  .project-wheel__drum {
    position: absolute;
