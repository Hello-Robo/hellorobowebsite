---
/**
 * Home — Hero
 * Figma: 1.0 home → "1 hero" (10093:119), 1728×1117
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-119
 *
 * Marked "3d web gl". On desktop one WebGL scene replaces the pictures
 * (src/scripts/hero-robot.ts → hero-scene.ts): the 3D robot, cropped at the torso, follows
 * the mouse with his head; behind him the sticker graphics lie on a virtual sphere that turns
 * against the head. Its settings and that picture are edited in the CMS (Home page → Hero
 * (3D, desktop)). The still pictures show while it loads and come
 * back if it can't (no WebGL, model failed). Phones and tablets keep the still pictures.
 *
 * CRT: Figma's CRT screen shader (CrtScreen, overlay) lies over the picture and the robot,
 * with the Showcase section's settings; the title sits above it, untouched. The hero's bottom
 * edge is straight (no corner notches).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import CrtScreen from '../../components/ui/CrtScreen.astro';
import sphere from '../../assets/home/hero-sphere.png';
import robot from '../../assets/home/hero-robot.png';
// the CRT layer over the hero: the Showcase section's settings, every darkening strength
// 10% lighter (scanlines 38, mask 9, flicker 22, static 8, vignette 13 → ×0.9)
const crt = { scanlines: 34.2, mask: 8.1, flicker: 19.8, noise: 7.2, vignette: 11.7, rollSpeed: 0.35 };
// the 3D scene's settings and background picture, from the CMS (Home page → Hero)
const { background, ...heroSettings } = (await getCollection('home'))[0]?.data.hero ?? {};
const heroData = JSON.stringify({ ...heroSettings, background: background?.src ?? sphere.src });
---
<section class="home-hero" aria-labelledby="home-hero-title" data-hero={heroData}>
  <WebGLSlot name="home-hero" class="home-hero__scene">
    <Image
      class="home-hero__sphere"
      src={sphere}
      alt=""
      widths={[1200, 2002]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__robot-frame">
      <Image
        class="home-hero__robot"
        src={robot}
        alt="Hello Robo service robot with a 79% display"
        widths={[900, 1520]}
        sizes="100vw"
        loading="eager"
      />
    </div>
  </WebGLSlot>

  <h1 id="home-hero-title" class="home-hero__title t-h1">Make<br class="only-mobile" /> the world<br class="only-mobile" /> say yes<br class="only-mobile" /> to your robot</h1>

  <!-- Figma's CRT screen shader over the sphere and robot (the title sits above it), as on the
       Showcase section; desktop only (CrtScreen leaves phones the plain picture) -->
  <CrtScreen overlay settings={crt} />

</section>

<script>
  import { isDesktop } from '../../scripts/media-query';
  // the WebGL hero: three.js, the model and the background are only fetched on desktop
  if (isDesktop()) {
    import('../../scripts/hero-robot').catch(() =>
      document.querySelector('.home-hero')?.classList.add('is-robot-fallback'),
    );
  }
</script>

<style>
  /* Positions are percentages of the 1728×1117 Figma frame */
  .home-hero {
    position: relative;
    aspect-ratio: 1728 / 1117;
    overflow: hidden;
    background: var(--color-white);
  }
  .home-hero :global(.home-hero__scene) {
    position: absolute;
    inset: 0;
  }
  /* Sphere: 1784×1118, centred */
  .home-hero :global(.home-hero__sphere) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(1784 / 1728 * 100%);
    height: calc(1118 / 1117 * 100%);
    transform: translate(-50%, -50%);
    object-fit: cover;
  }
  /* Robot: a 1772×757 window at (-5, 480); the image inside is 285.71% tall, offset -48.85% */
  .home-hero__robot-frame {
    position: absolute;
    left: calc(-5 / 1728 * 100%);
    top: calc(480 / 1117 * 100%);
    width: calc(1772 / 1728 * 100%);
    height: calc(757 / 1117 * 100%);
    overflow: hidden;
  }
  .home-hero :global(.home-hero__robot) {
    position: absolute;
    left: 0;
    top: -48.85%;
    width: 100%;
    height: 285.71%;
    max-width: none;
  }
  /* desktop: the WebGL scene (robot and background) replaces both pictures; the canvas
     fills the hero and fades in once drawn. The pictures only show if it can't. */
  .home-hero :global(.home-hero__robot-canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-smooth) var(--ease-out);
  }
  .home-hero :global(.is-robot-live .home-hero__robot-canvas) {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .home-hero:not(.is-robot-fallback) .home-hero__robot-frame {
      visibility: hidden;
    }
  }
  .home-hero__title {
    position: absolute;
    top: var(--space-40);
    left: var(--page-margin);
    width: calc(1095 / 1728 * 100%);
    color: var(--color-orange);
    /* above the CRT layer, so the title stays clean */
    z-index: calc(var(--z-raised) + 1);
  }
  /* the CRT layer over the picture and the robot, under the title */
  .home-hero :global(.crt) {
    z-index: var(--z-raised);
  }

  /* ── Mobile: Figma "home mob" (10101:6462), 390×844 ── */
  @media (max-width: 1023px) {
    .home-hero {
      aspect-ratio: 390 / 844;
    }
    /* Receipt sphere: cropped to its centre (Figma shows a close-up of the receipts) */
    .home-hero :global(.home-hero__sphere) {
      width: 260%;
      height: 100%;
    }
    /* Robot: a 723×484 window at (-167, 419) */
    .home-hero__robot-frame {
      left: calc(-167 / 390 * 100%);
      top: calc(419 / 844 * 100%);
      width: calc(723 / 390 * 100%);
      height: calc(484 / 844 * 100%);
    }
    .home-hero :global(.home-hero__robot) {
      top: -31%;
      height: auto;
    }
    .home-hero__title {
      top: var(--space-20);
      width: calc(100% - 2 * var(--page-margin));
    }
  }
</style>
