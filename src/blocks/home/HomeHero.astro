---
/**
 * Home — Hero
 * Figma: 1.0 home → "1 hero" (10093:119), 1728×1117
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-119
 *
 * Marked "3d web gl". On desktop (src/scripts/hero-sphere.ts) the receipts picture becomes
 * the inside of a sphere, the camera at its centre, turning very slowly; the robot photo
 * and the title stay on top. Phones, tablets and browsers without WebGL 2 keep the still
 * picture. (The receipt photo under the sphere in Figma is fully covered by it, so it
 * isn't used.)
 *
 * The robot is a 3D model on desktop too (src/scripts/hero-robot.ts): the body stays put
 * and the head turns a little. The photo is hidden there while the model loads, and comes
 * back if it can't (no WebGL, model failed). Phones and tablets keep the photo.
 *
 * CRT: Figma's CRT screen shader (CrtScreen, overlay) lies over the whole hero, the title
 * too, with the Showcase section's settings. The hero's bottom edge is straight (no corner
 * notches).
 */
import { Image } from 'astro:assets';
import WebGLSlot from '../../components/ui/WebGLSlot.astro';
import CrtScreen from '../../components/ui/CrtScreen.astro';
import sphere from '../../assets/home/hero-sphere.png';
import robot from '../../assets/home/hero-robot.png';
// the CRT layer over the whole hero: the same settings as the Showcase section below
const crt = { flicker: 22, noise: 8, rollSpeed: 0.35 };
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <WebGLSlot name="home-hero" class="home-hero__scene">
    <Image
      class="home-hero__sphere"
      src={sphere}
      alt=""
      widths={[1200, 2002]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__robot-frame">
      <Image
        class="home-hero__robot"
        src={robot}
        alt="Hello Robo service robot with a 79% display"
        widths={[900, 1520]}
        sizes="100vw"
        loading="eager"
      />
    </div>
  </WebGLSlot>

  <h1 id="home-hero-title" class="home-hero__title t-h1">Make<br class="only-mobile" /> the world<br class="only-mobile" /> say yes<br class="only-mobile" /> to your robot</h1>

  <!-- Figma's CRT screen shader over the whole hero (sphere, robot and title), as on the
       Showcase section; desktop only (CrtScreen leaves phones the plain picture) -->
  <CrtScreen overlay settings={crt} />

</section>

<script>
  import '../../scripts/hero-sphere';
  // the 3D robot: three.js and the model are only fetched on desktop
  if (matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches) {
    import('../../scripts/hero-robot').catch(() =>
      document.querySelector('.home-hero')?.classList.add('is-robot-fallback'),
    );
  }
</script>

<style>
  /* Positions are percentages of the 1728×1117 Figma frame */
  .home-hero {
    position: relative;
    aspect-ratio: 1728 / 1117;
    overflow: hidden;
    background: var(--color-white);
  }
  .home-hero :global(.home-hero__scene) {
    position: absolute;
    inset: 0;
  }
  /* desktop: the sphere's canvas fills the hero; the still picture fades out over it once
     the first frame is drawn (the robot stays on top) */
  .home-hero :global(.home-hero__canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .home-hero :global(.home-hero__sphere) {
    transition: opacity var(--duration-smooth) var(--ease-out);
  }
  .home-hero :global(.is-live .home-hero__sphere) {
    opacity: 0;
  }
  /* Sphere: 1784×1118, centred */
  .home-hero :global(.home-hero__sphere) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(1784 / 1728 * 100%);
    height: calc(1118 / 1117 * 100%);
    transform: translate(-50%, -50%);
    object-fit: cover;
  }
  /* Robot: a 1772×757 window at (-5, 480); the image inside is 285.71% tall, offset -48.85% */
  .home-hero__robot-frame {
    position: absolute;
    left: calc(-5 / 1728 * 100%);
    top: calc(480 / 1117 * 100%);
    width: calc(1772 / 1728 * 100%);
    height: calc(757 / 1117 * 100%);
    overflow: hidden;
  }
  .home-hero :global(.home-hero__robot) {
    position: absolute;
    left: 0;
    top: -48.85%;
    width: 100%;
    height: 285.71%;
    max-width: none;
  }
  /* desktop: the 3D robot replaces the photo; the canvas fills the hero and fades in once
     drawn. The photo only shows if the model can't. */
  .home-hero :global(.home-hero__robot-canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-smooth) var(--ease-out);
  }
  .home-hero :global(.is-robot-live .home-hero__robot-canvas) {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) {
    .home-hero:not(.is-robot-fallback) .home-hero__robot-frame {
      visibility: hidden;
    }
  }
  .home-hero__title {
    position: absolute;
    top: var(--space-40);
    left: var(--page-margin);
    width: calc(1095 / 1728 * 100%);
    color: var(--color-orange);
    z-index: var(--z-raised);
  }
  /* the CRT layer over everything, the title too (as on the Showcase section) */
  .home-hero :global(.crt) {
    z-index: calc(var(--z-raised) + 1);
  }

  /* ── Mobile: Figma "home mob" (10101:6462), 390×844 ── */
  @media (max-width: 1023px) {
    .home-hero {
      aspect-ratio: 390 / 844;
    }
    /* Receipt sphere: cropped to its centre (Figma shows a close-up of the receipts) */
    .home-hero :global(.home-hero__sphere) {
      width: 260%;
      height: 100%;
    }
    /* Robot: a 723×484 window at (-167, 419) */
    .home-hero__robot-frame {
      left: calc(-167 / 390 * 100%);
      top: calc(419 / 844 * 100%);
      width: calc(723 / 390 * 100%);
      height: calc(484 / 844 * 100%);
    }
    .home-hero :global(.home-hero__robot) {
      top: -31%;
      height: auto;
    }
    .home-hero__title {
      top: var(--space-20);
      width: calc(100% - 2 * var(--page-margin));
    }
  }
</style>
