---
/**
 * Home — Intro
 * Figma: "2 intro" (10093:145), 1728×1012
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10093-145
 */
---
<section class="home-intro">
  <img
    class="home-intro__stamp"
    src="/images/home/stamp-intro.svg"
    alt=""
    width="342" style="--w: 342"
    height="144"
    loading="lazy"
  />
  <p class="home-intro__text t-h3">
    Hello Robo is the design studio robotics companies call when the machine works but the world isn’t sold yet. We shape how a robot is seen, used, and talked about, from its brand and the screens operators rely on to the films that introduce it to buyers and investors.
  </p>
</section>

<style>
  .home-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* stamp at 213 from the top; the same 213 under the text */
    padding-top: calc(213 * var(--px));
    padding-bottom: calc(213 * var(--px)); /* as much room under the text as above the stamp */
    gap: calc(33 * var(--px));
    text-align: center;
  }
  .home-intro__stamp {
    width: calc(342 * var(--px));
    height: auto;
  }
  /* As the Robo Radio intro: a step under H3 (50) at 44, in a box 10% narrower than
     Figma's (795 for Figma's breaks at 50 → 700 at 44 → 630) */
  .home-intro__text {
    font-size: max(26px, calc(44 * var(--px)));
    width: calc(630 * var(--px));
    text-wrap: pretty; /* no single word left on the last line */
    max-width: 100%;
  }

  /* ── Mobile: Figma 10101:6503 — the drawn stamp is 193 wide at (98, 44), text 326 wide at
     160 (+164 divider). The SVG has room around the drawing (279 of its 342), so the file is
     237 wide (193 / 279 × 342) and sits 30 from the top, centred on the drawing ── */
  @media (max-width: 1023px) {
    .home-intro {
      /* half of Figma's 396 under the text: it read as an empty screen */
      padding: 194px 32px 198px;
      gap: 0;
    }
    .home-intro__stamp {
      width: 237px;
      /* the drawing sits 3.5px left of the file's middle; this centres the drawing */
      margin-left: 7px;
    }
    .home-intro__text {
      font-size: var(--type-h3-size-mobile);
      width: 100%;
      margin-top: 30px;
    }
  }
</style>
