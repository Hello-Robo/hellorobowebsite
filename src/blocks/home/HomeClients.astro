---
/**
 * Home — Clients
 * Figma: "Frame 2147232804" (10488:173), 1728×1481
 * https://www.figma.com/design/9SsfbCUY7KcxjZpCuRpDxf/Hello-Robo-Website-2026?node-id=10488-173
 * Under the text, a staggered grid of 13 logos (rows of 3, 2, 3, 2, 3): each sits centred in
 * a 329×193 place; positions are taken from the 1728 frame and expressed as % so they scale
 * with the page.
 * Mobile: three rows of logo tiles bleeding off both edges; while the block crosses the
 * screen the rows drift sideways, alternating directions.
 * The logos come from the CMS (Home page › Client logos) and fill the 13 places in order,
 * each at its own width (px at 1728, as in Figma). A place can hold a Hello Robo micrographic
 * instead (CMS "Micrographic"): shown the same way, but decorative (no alt text).
 */
import { getCollection } from 'astro:content';

// The 13 places: top-left x, y of each 329×193 place in the 1728 frame (Figma y − 100), row by row
const places = [
  { x: 40, y: 705 }, { x: 700, y: 705 }, { x: 1359, y: 705 },
  { x: 369, y: 818 }, { x: 1028, y: 818 },
  { x: 40, y: 898 }, { x: 700, y: 898 }, { x: 1359, y: 898 },
  { x: 369, y: 1011 }, { x: 1028, y: 1011 },
  { x: 40, y: 1091 }, { x: 700, y: 1091 }, { x: 1359, y: 1091 },
];
// Figma's frame is 1481 tall; the logos sit 100 higher (less space under the text)
const FRAME_H = 1381;
const PLACE_W = 329;
const PLACE_H = 193;
const clients = (await getCollection('home'))[0]?.data.clients ?? [];
// phones: rows of 5, 4, 4
const mobileRow = (i: number) => (i < 5 ? 0 : i < 9 ? 1 : 2);
const tiles = clients.slice(0, places.length).map((c, i) => ({
  name: c.name,
  src: c.logo,
  width: c.width || 140,
  micrographic: c.micrographic,
  row: mobileRow(i),
  ...places[i],
}));
const pct = (v: number, of: number) => `${(v / of) * 100}%`;
---
<section class="home-clients">
  <div class="home-clients__text container">
    <img class="home-clients__stamp-text" src="/images/home/stamp-clients.svg" alt="" width="306" style="--w: 306" height="76" loading="lazy" />
    <p class="home-clients__label t-body">Clients</p>
    <h2 class="home-clients__title t-h3">
      And we are doing it together with visionary founders who are ready for the world to adopt their robots. And they chose to do it with Hello Robo.
    </h2>
  </div>

  <ul class="home-clients__wall" aria-label="Clients" data-clients-wall>
    {tiles.map((t) => (
      <li
        class="home-clients__tile"
        style={`left:${pct(t.x, 1728)};top:${pct(t.y, FRAME_H)};--logo-w:${t.width};--row:${t.row};--dir:${t.row % 2 ? -1 : 1}`}
      >
        <img src={t.src} alt={t.micrographic ? '' : t.name} loading="lazy" />
      </li>
    ))}
  </ul>
</section>

<script>
  // Scroll drift for the mobile logo rows: --shift goes from +1 to -1 as the wall
  // crosses the screen (the CSS turns it into px and only uses it on phones)
  const wall = document.querySelector<HTMLElement>('[data-clients-wall]');
  if (wall && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const r = wall.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight + r.height)));
      wall.style.setProperty('--shift', (1 - 2 * p).toFixed(4));
    };
    const request = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    update();
  }
</script>

<style>
  .home-clients {
    position: relative;
    aspect-ratio: 1728 / 1381;
    /* hidden first: iOS before 16 has no `clip` and would widen the page */
    overflow-x: hidden;
    overflow-x: clip;
  }
  .home-clients__text {
    position: relative;
    z-index: var(--z-raised);
    padding-top: calc(191 * var(--px));
  }
  /* The SVG includes 13/calc(8 * var(--px)) of stroke overflow around the 280×60 stamp */
  .home-clients__stamp-text {
    margin: calc(-8 * var(--px)) calc(-13 * var(--px));
  }
  .home-clients__label {
    margin-top: calc(32 * var(--px));
  }
  .home-clients__title {
    width: calc(835 * var(--px));
    max-width: 50%;
    margin-top: calc(32 * var(--px));
  }
  .home-clients__wall {
    position: absolute;
    inset: 0;
  }
  /* A 329×193 place; the logo centred in it at its own width (Figma px, scaled with the page) */
  .home-clients__tile {
    position: absolute;
    width: calc(329 / 1728 * 100%);
    aspect-ratio: 329 / 193;
    display: grid;
    place-items: center;
  }
  .home-clients__tile img {
    width: calc(var(--logo-w) / 329 * 100%);
    max-width: 90%;
    max-height: 95%;
    height: auto;
    object-fit: contain;
  }

  /* ── Mobile: text, then three rows of logo tiles (5, 4, 4) bleeding off both edges ── */
  @media (max-width: 1023px) {
    .home-clients {
      aspect-ratio: auto;
      padding-bottom: 160px;
    }
    .home-clients__text {
      padding-top: 188px;
    }
    /* Stamp 205×44 → the SVG (with its stroke overflow) at 224 */
    .home-clients__stamp-text {
      width: 224px;
      height: auto;
      margin: -6px -10px;
    }
    .home-clients__label {
      margin-top: 44px;
    }
    .home-clients__title {
      width: auto;
      max-width: none;
      margin-top: var(--space-24);
    }
    /* Tiles 165×97 (Figma's 329×193 at half); rows 2 and 3 start half a tile in */
    .home-clients__wall {
      --tile: 165px;
      --shift: 0;
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(5, var(--tile));
      grid-auto-rows: 97px;
      gap: 0;
      width: max-content;
      margin: 64px 0 0 calc(50% - 2.5 * var(--tile));
    }
    .home-clients__tile {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: var(--tile);
      grid-row: calc(var(--row) + 1);
      transform: translateX(calc(var(--dir) * (var(--tile) / 4 + var(--shift) * 40px)));
    }
    .home-clients__tile:nth-child(6),
    .home-clients__tile:nth-child(10) {
      grid-column: 1;
    }
    .home-clients__tile img {
      width: calc(var(--logo-w) * 0.5px);
    }
  }
</style>
