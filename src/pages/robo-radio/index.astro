---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RadioTV from '../../blocks/radio/RadioTV.astro';
import RadioIntro from '../../blocks/radio/RadioIntro.astro';
import RadioCollage from '../../blocks/radio/RadioCollage.astro';
import RadioInvite from '../../blocks/radio/RadioInvite.astro';
import RadioEpisodes from '../../blocks/radio/RadioEpisodes.astro';
import RadioGuests from '../../blocks/radio/RadioGuests.astro';
---
<BaseLayout title={'Robo Radio'} headerVariant="light">
  <RadioTV variant="hero" />
  <RadioIntro />
  {/* "Conversations in the field" (RadioClips) is hidden for now; to bring it back, import
      ../../blocks/radio/RadioClips.astro and put <RadioClips /> here */}
  <RadioCollage />
  <RadioInvite />
  <RadioEpisodes />
  <RadioGuests />
</BaseLayout>
